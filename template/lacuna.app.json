{
  "manifestVersion": 1,
  "id": "io.github.maker-username.community-app",
  "name": "Community app",
  "version": "0.1.0",
  "summary": "A small shelf app.",
  "description": "A small shelf app. One list of items. Shared buttons and cards. Token colors and type. Copy this starter, set your name, username and id, and keep the manifest valid.",
  "category": "productivity",
  "folder": "Track/Lists",
  "tags": [],
  "icon": "docs",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "third-party",
    "name": "Maker name",
    "github": "maker-username"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "bundle",
    "route": "/app/community-app",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "edit:community-app"
  ],
  "permissions": {
    "records": [],
    "platform": [],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/community-app-open-and-reload.spec.ts",
      "tests/edit-community-app.spec.ts",
      "tests/community-app-denied-action.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
