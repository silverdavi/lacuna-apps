{
  "manifestVersion": 1,
  "id": "lacuna.to-do",
  "name": "Task List",
  "version": "0.1.0",
  "summary": "A personal to-do list that tracks progress.",
  "description": "Add, check off, edit, reorder, and delete tasks. The list survives reload on this device. Nothing leaves the browser.",
  "category": "productivity",
  "tags": [],
  "icon": "tasks",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/to-do"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/confirm-dialog": "0.1.0",
      "@lacuna/export-menu": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/json-backup": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/use-collection": "0.1.0"
    }
  },
  "capabilities": [
    "edit:task"
  ],
  "permissions": {
    "records": [
      {
        "kind": "task",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the personal to-do list"
      }
    ],
    "platform": [
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "task"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/aa-matchers.spec.ts",
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
