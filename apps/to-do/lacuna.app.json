{
  "manifestVersion": 1,
  "id": "lacuna.to-do",
  "name": "To-do",
  "version": "0.1.0",
  "summary": "Keep one list of tasks, check them off, and see how far you have come.",
  "description": "One list of tasks. Add a task, check it off, reorder, edit, or delete it with undo. Progress is a bar at the top. Everything stays on this page and survives a reload. Nothing leaves the browser.",
  "category": "productivity",
  "tags": ["tasks", "list", "productivity"],
  "icon": "tasks",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "builtin",
    "route": "/app/to-do"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "create:task",
    "edit:task"
  ],
  "permissions": {
    "records": [
      {
        "kind": "task",
        "access": [
          "read",
          "write",
          "create",
          "delete"
        ],
        "purpose": "Create, edit, complete, and delete to-do tasks in a single list"
      }
    ],
    "platform": [
      "identity.profile.read"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "task"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
