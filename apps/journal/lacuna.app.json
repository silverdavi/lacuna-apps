{
  "manifestVersion": 1,
  "id": "lacuna.journal",
  "name": "Daily journal",
  "version": "0.1.0",
  "summary": "Write a daily entry in markdown, lock it, and keep a backup.",
  "description": "A single daily entry in markdown with a live preview. Save with Ctrl+S, lock the entry with a passphrase, and export or import a JSON backup. The data stays on this device.",
  "category": "personal",
  "icon": "docs",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "builtin",
    "route": "/app/journal"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/dialog": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/json-backup": "0.1.0",
      "@lacuna/markdown-to-html": "0.1.0",
      "@lacuna/markdown-view": "0.1.0",
      "@lacuna/passphrase-crypto": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "edit:journal"
  ],
  "permissions": {
    "records": [
      {
        "kind": "journal",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the daily journal entry"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "journal"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/00-readonly-matcher.spec.ts",
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
