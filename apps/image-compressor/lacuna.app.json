{
  "manifestVersion": 1,
  "id": "lacuna.image-compressor",
  "name": "Image Compressor",
  "version": "0.1.0",
  "summary": "Drop an image, set format, quality, and size, then download the result.",
  "description": "Drop a local image to preview it, set compression options such as format, quality, and dimensions, and download the compressed result. Rotate, flip, and resize on the spot. The last used options are kept locally so they persist across reloads. Nothing leaves the browser.",
  "category": "productivity",
  "tags": ["image", "compress", "resize"],
  "icon": "paint",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "bundle",
    "route": "/app/image-compressor",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "convert:image",
    "edit:image"
  ],
  "permissions": {
    "records": [
      {
        "kind": "image",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Hold the dropped image and the compression options applied to it"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "image"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
