{
  "manifestVersion": 1,
  "id": "lacuna.pomodoro-timer",
  "name": "Pomodoro Timer",
  "version": "0.1.0",
  "summary": "Run 25-minute focus intervals with 5-minute breaks, and track your sessions and streak.",
  "description": "A focus timer with 25-minute focus phases and 5-minute breaks. Start, pause, and skip phases. Completed focus sessions are listed in history with a daily streak.",
  "category": "productivity",
  "tags": [],
  "icon": "calendar",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "bundle",
    "route": "/app/pomodoro-timer",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/streak-calc": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0",
      "@lacuna/use-timer": "0.1.0"
    }
  },
  "capabilities": [
    "edit:pomodoro-timer"
  ],
  "permissions": {
    "records": [
      {
        "kind": "pomodoro-timer",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Own Pomodoro Timer sessions and streak"
      }
    ],
    "platform": [],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "pomodoro-timer"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
