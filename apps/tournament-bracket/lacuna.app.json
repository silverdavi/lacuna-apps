{
  "manifestVersion": 1,
  "id": "lacuna.tournament-bracket",
  "name": "Tournament Bracket",
  "version": "0.1.0",
  "summary": "Run a single-elimination tournament: seed players, pick winners, crown a champion.",
  "description": "Add players with seed numbers, watch them fill the bracket, and advance winners through each round until a champion is crowned. Review every match in the results table and export the results as CSV. The bracket is the record. Nothing leaves the browser.",
  "category": "productivity",
  "tags": ["tournament", "bracket", "single-elimination", "champion"],
  "icon": "people",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "builtin",
    "route": "/app/tournament-bracket"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/confirm-dialog": "0.2.0",
      "@lacuna/export-menu": "0.1.0",
      "@lacuna/filter-bar": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/json-backup": "0.1.0",
      "@lacuna/record-form": "0.1.0",
      "@lacuna/record-table": "0.1.0",
      "@lacuna/search-box": "0.1.0",
      "@lacuna/tag-input": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/use-clipboard": "0.1.0",
      "@lacuna/use-collection": "0.1.0"
    }
  },
  "capabilities": [
    "create:player",
    "edit:player",
    "edit:match",
    "export:csv"
  ],
  "permissions": {
    "records": [
      {
        "kind": "player",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the players and their seeds"
      },
      {
        "kind": "match",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the bracket matches and winners"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "player",
      "match"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
