{
  "manifestVersion": 1,
  "id": "lacuna.expense-tracker",
  "name": "Expense Tracker",
  "version": "0.1.0",
  "summary": "Log expenses with a category, see totals, keep budgets by category, export CSV.",
  "description": "Record expenses with a date, description, amount and category. See the ledger with a total spent, set a monthly budget per category and see how much of it is used. Export the ledger as CSV. Nothing leaves the browser.",
  "category": "productivity",
  "icon": "finance",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/expense-tracker"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/money": "0.1.0",
      "@lacuna/money-input": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/use-clipboard": "0.1.0",
      "@lacuna/use-collection": "0.1.0"
    }
  },
  "capabilities": [
    "create:transaction"
  ],
  "permissions": {
    "records": [
      {
        "kind": "transaction",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store logged expenses"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "transaction"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
