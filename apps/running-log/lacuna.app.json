{
  "manifestVersion": 1,
  "id": "lacuna.running-log",
  "name": "Running Log",
  "version": "0.1.0",
  "summary": "Log runs with date, distance, and time; see pace, a chart, and totals.",
  "description": "A runner's log: add runs with a date, distance, and time, and the app computes the pace. Rows sort by distance, a chart shows distance over time, and the log exports to CSV. Everything persists in the browser.",
  "category": "personal",
  "icon": "analytics",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "builtin",
    "route": "/app/running-log"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tracker-kit": "0.2.0",
      "@lacuna/use-collection": "0.1.0",
      "@lacuna/date-math": "0.1.0",
      "@lacuna/streak-calc": "0.1.0",
      "@lacuna/heatmap": "0.1.0",
      "@lacuna/chart": "0.1.0",
      "@lacuna/date-picker": "0.1.0",
      "@lacuna/export-menu": "0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/json-backup": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "create:run",
    "edit:run",
    "export:csv"
  ],
  "permissions": {
    "records": [
      {
        "kind": "run",
        "access": [
          "read",
          "write",
          "create",
          "delete"
        ],
        "purpose": "Store dated runs, their pace, and the trend they form"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "run"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
