{
  "manifestVersion": 1,
  "id": "lacuna.drum-machine",
  "name": "Drum Machine",
  "version": "0.1.0",
  "summary": "Pattern a 16-step rhythm and play it with Web Audio synthesis.",
  "description": "A grid of 16 pads. Toggle steps on and off, set a tempo, and play the pattern with synthesized drums. The pattern and the tempo persist across reloads. Nothing leaves the browser.",
  "category": "personal",
  "icon": "grid",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/drum-machine"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "create:pattern",
    "edit:pattern"
  ],
  "permissions": {
    "records": [
      {
        "kind": "pattern",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the rhythm pattern and its tempo"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "pattern"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
