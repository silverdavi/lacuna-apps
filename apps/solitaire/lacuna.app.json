{
  "manifestVersion": 1,
  "id": "lacuna.solitaire",
  "name": "Solitaire Game",
  "version": "0.1.0",
  "summary": "Play classic card solitaire offline.",
  "description": "Deal a standard 52-card deck, move cards between the tableau, foundations, and stock, and track your score and best score. The current game state persists across reloads. Nothing leaves the browser.",
  "category": "personal",
  "icon": "grid",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/solitaire"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "view:game",
    "edit:game"
  ],
  "permissions": {
    "records": [
      {
        "kind": "game",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the current solitaire game and its best score"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "game"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
