{
  "manifestVersion": 1,
  "id": "lacuna.water-tracker",
  "name": "Water Tracker",
  "version": "0.1.0",
  "summary": "Log daily water intake, keep a streak, and review your habits on a heatmap and trend.",
  "description": "A daily water intake tracker. Log how much you drink, watch your streak grow, and see your habit on a heatmap and a rolling trend.",
  "category": "personal",
  "tags": [
    "water",
    "habit",
    "streak",
    "health"
  ],
  "icon": "tasks",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "bundle",
    "route": "/app/water-tracker",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/tracker-kit": "^0.2.0",
      "@lacuna/use-collection": "^0.1.0",
      "@lacuna/date-math": "0.1.0",
      "@lacuna/streak-calc": "0.1.0",
      "@lacuna/heatmap": "0.1.0",
      "@lacuna/chart": "0.1.0",
      "@lacuna/date-picker": "^0.1.0",
      "@lacuna/export-menu": "^0.1.0",
      "@lacuna/json-backup": "^0.1.0"
    }
  },
  "capabilities": [
    "edit:water-tracker"
  ],
  "permissions": {
    "records": [
      {
        "kind": "water-tracker",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Own water intake records"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "water-tracker"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
