{
  "manifestVersion": 1,
  "id": "lacuna.baby-tracker",
  "name": "Baby Activity Log",
  "version": "0.1.0",
  "summary": "Log baby feeding, sleep and diaper entries with filters and CSV export.",
  "description": "Record baby feeding, sleep and diaper entries with an optional duration and notes. Filter the log by type, delete entries, export to CSV, and keep everything on this device.",
  "category": "personal",
  "tags": [],
  "icon": "calendar",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "bundle",
    "route": "/app/baby-tracker",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/host-mock": "0.1.0"
    }
  },
  "capabilities": [
    "create:activity",
    "edit:activity",
    "export:csv"
  ],
  "permissions": {
    "records": [
      {
        "kind": "activity",
        "access": [
          "read",
          "write",
          "create",
          "delete"
        ],
        "purpose": "Store baby activity entries (feeding, sleep, diaper)"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "activity"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
