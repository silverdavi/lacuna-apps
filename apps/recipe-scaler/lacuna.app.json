{
  "manifestVersion": 1,
  "id": "lacuna.recipe-scaler",
  "name": "Recipe Scaler",
  "version": "0.1.0",
  "summary": "Scale a recipe's ingredient quantities from a base serving size to a new target.",
  "description": "Enter ingredients with quantities and units, set the original and target servings, and see the scaled amounts in a breakdown table and summary. The scaled recipe survives reload. Nothing leaves the browser.",
  "category": "productivity",
  "tags": [],
  "icon": "sheets",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "bundle",
    "route": "/app/recipe-scaler",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "create:ingredient",
    "edit:recipe"
  ],
  "permissions": {
    "records": [
      {
        "kind": "ingredient",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store recipe ingredients, their quantities, and the serving sizes"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "ingredient"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
