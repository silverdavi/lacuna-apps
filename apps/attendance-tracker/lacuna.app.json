{
  "manifestVersion": 1,
  "id": "lacuna.attendance-tracker",
  "name": "Attendance Tracker",
  "version": "0.1.0",
  "summary": "Track who was present, absent, or late each day.",
  "description": "A list of attendance entries. Add a name, date, and status. Search, sort by date, delete entries, and export the current list as CSV. The data stays on this device.",
  "category": "productivity",
  "icon": "calendar",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "builtin",
    "route": "/app/attendance-tracker",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/use-clipboard": "0.1.0"
    }
  },
  "capabilities": [
    "edit:attendance"
  ],
  "permissions": {
    "records": [
      {
        "kind": "attendance",
        "access": [
          "read",
          "write",
          "create",
          "delete"
        ],
        "purpose": "Store attendance entries with name, date, and status"
      }
    ],
    "platform": [
      "identity.profile.read"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "attendance"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
