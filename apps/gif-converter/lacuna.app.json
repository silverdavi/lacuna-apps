{
  "manifestVersion": 1,
  "id": "lacuna.gif-converter",
  "name": "GIF Studio",
  "version": "0.1.0",
  "summary": "Assemble image sequences into animated GIF89a files with FPS, resize, and boomerang.",
  "description": "Drop multiple PNG, JPEG, or WebP frames or generate sample animation frames, set frame rate, target width, boomerang loop, and reverse order, preview the live animated GIF, and export a valid GIF89a file offline.",
  "category": "productivity",
  "tags": ["converter", "conversion-suite", "gif", "animation", "frames", "media"],
  "icon": "paint",
  "relationship": { "kind": "standalone" },
  "maintainer": { "type": "first-party", "name": "Lacuna", "url": "https://lacunaos.com" },
  "source": { "repository": "https://github.com/silverdavi/lacuna-apps", "license": "MIT" },
  "pricing": { "model": "free", "inAppPurchases": false, "ads": false },
  "maturity": "demo-working",
  "entry": { "type": "bundle", "route": "/app/gif-converter", "bundle": "dist/index.html" },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/use-local-record": "0.1.0"
    }
  },
  "capabilities": ["convert:frames->animation", "edit:gif-converter"],
  "permissions": {
    "records": [
      {
        "kind": "gif-converter",
        "access": ["read", "write", "create"],
        "purpose": "Persist GIF export settings and recent export history across reloads"
      }
    ],
    "platform": ["files.pick", "files.save"],
    "network": { "origins": [] },
    "dataClasses": [],
    "availability": { "spaceTypes": ["any"] }
  },
  "sharing": { "owns": ["gif-converter"], "reads": [], "handoffs": [] },
  "quality": {
    "tests": ["tests/acceptance.spec.ts"],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
