{
  "manifestVersion": 1,
  "id": "lacuna.helpdesk",
  "name": "Helpdesk",
  "version": "0.1.0",
  "summary": "Track support tickets with search, filters, sorting, and CSV export.",
  "description": "A full ticket workbench: add, edit, and delete support tickets with subject, customer, priority, and status. Search by text, filter by status, sort by any column, see open and high-priority counts, and export the filtered list to CSV. Tickets survive reload. Nothing leaves the browser.",
  "category": "productivity",
  "icon": "inbox",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/helpdesk"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/csv-parse": "0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "create:ticket",
    "edit:ticket",
    "export:csv"
  ],
  "permissions": {
    "records": [
      {
        "kind": "ticket",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the support tickets"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "ticket"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
