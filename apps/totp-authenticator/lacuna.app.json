{
  "manifestVersion": 1,
  "id": "lacuna.totp-authenticator",
  "name": "TOTP Authenticator",
  "version": "0.1.0",
  "summary": "Store base32 secrets and read current six-digit codes.",
  "description": "A list of accounts with base32 secrets. Add an account from a raw secret or an otpauth URI, read the current six-digit code, copy it, and delete it. The list persists on this device; nothing leaves the browser.",
  "category": "productivity",
  "icon": "security",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "builtin",
    "route": "/app/totp-authenticator",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "create:account",
    "edit:account"
  ],
  "permissions": {
    "records": [
      {
        "kind": "account",
        "access": [
          "read",
          "write",
          "create",
          "delete"
        ],
        "purpose": "Store the base32 secrets and labels of the accounts"
      }
    ],
    "platform": [
      "identity.profile.read"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "account"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
