{
  "manifestVersion": 1,
  "id": "lacuna.medication-tracker",
  "name": "Medication Reminder",
  "version": "0.1.0",
  "summary": "Track your medications and log doses.",
  "description": "A list of medications with scheduled times. Add a medication, log a dose when you take it, and review the dose history. The data stays on this device.",
  "category": "healthcare",
  "icon": "clinic",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "builtin",
    "route": "/app/medication-tracker",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/use-clipboard": "0.1.0"
    }
  },
  "capabilities": [
    "create:medication",
    "edit:dose",
    "edit:medication",
    "export:csv"
  ],
  "permissions": {
    "records": [
      {
        "kind": "medication",
        "access": [
          "read",
          "write",
          "create",
          "delete"
        ],
        "purpose": "Store medication names, doses, and scheduled times"
      },
      {
        "kind": "dose",
        "access": [
          "read",
          "create",
          "delete"
        ],
        "purpose": "Store the logged doses of each medication"
      }
    ],
    "platform": [
      "identity.profile.read"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "medication"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
