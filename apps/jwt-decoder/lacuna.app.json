{
  "manifestVersion": 1,
  "id": "lacuna.jwt-decoder",
  "name": "JWT Decoder",
  "version": "0.1.0",
  "summary": "Decode a JWT into its header, payload, and signature.",
  "description": "Paste a token or drop a file to see its header, payload, and signature. Copy any part, export the result as JSON, and keep a local history of decoded tokens.",
  "category": "productivity",
  "icon": "security",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/jwt-decoder"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/use-clipboard": "0.1.0",
      "@lacuna/file-save-open": "0.1.0"
    }
  },
  "capabilities": [
    "view:token",
    "create:decoded-token",
    "export:json"
  ],
  "permissions": {
    "records": [
      {
        "kind": "decoded-token",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store decoded tokens in the local history"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "decoded-token"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
