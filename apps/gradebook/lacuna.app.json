{
  "manifestVersion": 1,
  "id": "lacuna.gradebook",
  "name": "Gradebook",
  "version": "0.1.0",
  "summary": "Enter grades for students and assignments, see averages and statistics, and export a CSV.",
  "description": "Add students, record scores for each assignment, and read back averages per student, per assignment, and for the class. Statistics show class-level figures. Everything is stored locally in this device.",
  "category": "productivity",
  "tags": ["education", "grades", "csv"],
  "icon": "sheets",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/gradebook"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/number-input": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0",
      "@lacuna/export-menu": "0.1.0",
      "@lacuna/calculator-kit": "0.2.0",
      "@lacuna/money-input": "0.1.0",
      "@lacuna/money": "0.1.0",
      "@lacuna/chart": "0.1.0",
      "@lacuna/csv-parse": "0.1.0",
      "@lacuna/use-local-record": "0.1.0"
    }
  },
  "capabilities": [
    "create:student",
    "edit:grade",
    "edit:student",
    "view:average",
    "export:csv"
  ],
  "permissions": {
    "records": [
      {
        "kind": "gradebook",
        "access": [
          "read",
          "write",
          "create",
          "delete"
        ],
        "purpose": "Store the class roster and the grades entered for it"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "gradebook"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
