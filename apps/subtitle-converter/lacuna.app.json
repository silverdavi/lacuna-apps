{
  "manifestVersion": 1,
  "id": "lacuna.subtitle-converter",
  "name": "Subtitle Converter",
  "version": "0.1.0",
  "summary": "Convert, time-shift, and clean SRT, WebVTT, ASS, SBV, JSON, and plain transcripts.",
  "description": "Paste or open subtitle files offline to convert across SRT, WebVTT, ASS/SSA, YouTube SBV, JSON, and plain text transcripts, with millisecond time-shifting, frame-rate speed stretch, and tag stripping.",
  "category": "productivity",
  "tags": ["converter", "conversion-suite", "subtitles", "srt", "vtt", "ass", "captions"],
  "icon": "docs",
  "relationship": { "kind": "standalone" },
  "maintainer": { "type": "first-party", "name": "Lacuna", "url": "https://lacunaos.com" },
  "source": { "repository": "https://github.com/silverdavi/lacuna-apps", "license": "MIT" },
  "pricing": { "model": "free", "inAppPurchases": false, "ads": false },
  "maturity": "demo-working",
  "entry": { "type": "bundle", "route": "/app/subtitle-converter", "bundle": "dist/index.html" },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0",
      "@lacuna/use-local-record": "0.1.0"
    }
  },
  "capabilities": ["convert:subtitles->captions", "edit:subtitle-converter"],
  "permissions": {
    "records": [
      {
        "kind": "subtitle-converter",
        "access": ["read", "write", "create"],
        "purpose": "Persist active subtitle text, target format, and timing shift across reloads"
      }
    ],
    "platform": ["files.pick", "files.save", "clipboard.write"],
    "network": { "origins": [] },
    "dataClasses": [],
    "availability": { "spaceTypes": ["any"] }
  },
  "sharing": { "owns": ["subtitle-converter"], "reads": [], "handoffs": [] },
  "quality": {
    "tests": ["tests/acceptance.spec.ts"],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
