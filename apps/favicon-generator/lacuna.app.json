{
  "manifestVersion": 1,
  "id": "lacuna.favicon-generator",
  "name": "Favicon Generator",
  "version": "0.1.0",
  "summary": "Turn one image into a full set of favicons, locally.",
  "description": "Drop a logo and Lacuna cuts it into the eight standard favicon sizes with a square or circle crop and a quality setting. Apply, preview, and download the set as a zip or as individual PNGs. Everything happens on this page; the generated set survives a reload.",
  "category": "productivity",
  "tags": [
    "images",
    "favicons",
    "local"
  ],
  "icon": "paint",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/favicon-generator"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/ui": "^0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/use-local-record": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0"
    }
  },
  "capabilities": [
    "edit:favicon-set"
  ],
  "permissions": {
    "records": [
      {
        "kind": "favicon-set",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Keep the last generated set and its settings on this device"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "favicon-set"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts",
      "tests/debug-circle.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
