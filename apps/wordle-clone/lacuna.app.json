{
  "manifestVersion": 1,
  "id": "lacuna.wordle-clone",
  "name": "Wordle Game",
  "version": "0.1.0",
  "summary": "Guess the hidden five-letter word in six tries.",
  "description": "Type a five-letter guess, press Enter, and watch the letters light up. Six tries a game, and the wins and best streak stay on this device.",
  "category": "personal",
  "icon": "grid",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "builtin",
    "route": "/app/wordle-clone"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/board-grid": "0.1.0",
      "@lacuna/dialog": "0.1.0",
      "@lacuna/grid-utils": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/random": "0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/use-hotkeys": "0.1.0",
      "@lacuna/use-local-record": "0.1.0",
      "@lacuna/use-timer": "0.1.0"
    }
  },
  "capabilities": [
    "edit:game"
  ],
  "permissions": {
    "records": [
      {
        "kind": "game",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the run state and the stats between visits"
      }
    ],
    "platform": [
      "identity.profile.read"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "game"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
