{
  "manifestVersion": 1,
  "id": "lacuna.paint",
  "name": "Paint",
  "version": "0.1.0",
  "summary": "A small paint surface for quick sketches and annotated diagrams.",
  "description": "Pick a brush, a color, and a size. Draw with the mouse, a pen, or a finger. Undo a mistake, clear the surface, and export a PNG. The drawing survives a reload.",
  "category": "productivity",
  "tags": ["sketch", "diagram", "paint"],
  "icon": "design",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "builtin",
    "route": "/app/paint"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/range-slider": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "edit:paint"
  ],
  "permissions": {
    "records": [
      {
        "kind": "paint",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the current drawing so it survives a reload"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "paint"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
