{
  "manifestVersion": 1,
  "id": "lacuna.diagram-editor",
  "name": "Flowchart Editor",
  "version": "0.1.0",
  "summary": "Draw and connect labeled shapes on a canvas, manage layers, and export or back up the flowchart.",
  "description": "Draw rectangles and ellipses on a canvas, label and recolor them, connect shapes with connectors, manage them in the Layers panel, review a Data summary, and export the flowchart as PNG, SVG, or a JSON backup you can import back. The diagram is a record. Nothing leaves the browser.",
  "category": "productivity",
  "icon": "whiteboard",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "bundle",
    "route": "/app/diagram-editor",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/export-menu": "0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/json-backup": "0.1.0",
      "@lacuna/color-palette": "0.1.0"
    }
  },
  "capabilities": [
    "create:shape",
    "edit:shape",
    "edit:connector",
    "view:layers",
    "export:png",
    "export:svg",
    "export:json",
    "import:json"
  ],
  "permissions": {
    "records": [
      {
        "kind": "flowchart",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the shapes of the flowchart"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "flowchart"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
