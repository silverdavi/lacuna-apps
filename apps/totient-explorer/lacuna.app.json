{
  "manifestVersion": 1,
  "id": "lacuna.totient-explorer",
  "name": "Totient explorer",
  "version": "0.1.0",
  "summary": "Factor a number and test it against Lehmer, Carmichael and Korselt.",
  "description": "Type a whole number to see its factorization, Euler's phi, Carmichael's lambda, the Lehmer index and a ladder of verdicts. Scan ranges, list Carmichael numbers, and read a short note on Lehmer's open problem.",
  "category": "productivity",
  "tags": ["math", "number-theory", "totient", "carmichael", "lehmer"],
  "icon": "school",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/totient-explorer"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "export:scan"
  ],
  "permissions": {
    "records": [
      {
        "kind": "scan",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Keep the last number, scan range and tab on this device"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "scan"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/nt.spec.ts",
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
