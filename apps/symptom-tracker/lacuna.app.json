{
  "manifestVersion": 1,
  "id": "lacuna.symptom-tracker",
  "name": "Symptom Tracker",
  "version": "0.1.0",
  "summary": "Log symptoms, see trends, and track your streak.",
  "description": "A local, no-network symptom tracker. Log daily symptom check-ins with severity, build a history of entries on a calendar, review trends and a heatmap of activity, and back up or export your data as JSON. Everything stays on this device.",
  "category": "healthcare",
  "tags": ["health", "symptoms", "tracker", "calendar", "trends"],
  "icon": "clinic",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "builtin",
    "route": "/app/symptom-tracker"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/date-math": "0.1.0",
      "@lacuna/streak-calc": "0.1.0",
      "@lacuna/heatmap": "0.1.0",
      "@lacuna/chart": "0.1.0",
      "@lacuna/csv-parse": "0.1.0",
      "@lacuna/host-mock": "0.1.0"
    }
  },
  "capabilities": [
    "edit:symptom-entry"
  ],
  "permissions": {
    "records": [
      {
        "kind": "symptom-entry",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Own Symptom Tracker records"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "symptom-entry"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
