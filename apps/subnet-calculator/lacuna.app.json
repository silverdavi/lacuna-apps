{
  "manifestVersion": 1,
  "id": "lacuna.subnet-calculator",
  "name": "IP Subnet Calculator",
  "version": "0.1.0",
  "summary": "IP subnet calculator with network, broadcast, and host details plus a saved list.",
  "description": "Enter an IP address and prefix length to see the network address, broadcast address, subnet mask, and usable host range. Save calculations to a list that stays on this device.",
  "category": "productivity",
  "tags": [
    "networking",
    "ip",
    "subnet"
  ],
  "icon": "grid",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "contact": "maintainers@lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "bundle",
    "route": "/app/subnet-calculator",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/calculator-kit": "0.2.0",
      "@lacuna/chart": "0.1.0",
      "@lacuna/export-menu": "0.1.0",
      "@lacuna/number-input": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0",
      "@lacuna/use-local-record": "0.1.0"
    }
  },
  "capabilities": [
    "edit:subnet-calculator"
  ],
  "permissions": {
    "records": [
      {
        "kind": "subnet-calculator",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Own saved subnet calculations"
      }
    ],
    "platform": [
      "identity.profile.read"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "subnet-calculator"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
