{
  "manifestVersion": 1,
  "id": "lacuna.gif-maker",
  "name": "GIF Maker",
  "version": "0.1.0",
  "summary": "Turn a set of images into an animated GIF: pick frames, set the timing and size, export.",
  "description": "Drop a few frames or add the sample set, tune the per-frame delay and the output size, and export the result as a GIF. The last project — frame list, delay, size — is kept on this device. Nothing leaves the browser.",
  "category": "productivity",
  "icon": "paint",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/gif-maker"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/progress-ring": "0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0",
      "@lacuna/use-local-record": "0.1.0"
    }
  },
  "capabilities": [
    "create:gif",
    "export:gif"
  ],
  "permissions": {
    "records": [
      {
        "kind": "gif-project",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the frame list and export settings for the last project"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "gif-project"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
