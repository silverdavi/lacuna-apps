{
  "manifestVersion": 1,
  "id": "lacuna.math-practice",
  "name": "Math Practice",
  "version": "0.1.0",
  "summary": "Generate, study, and track arithmetic practice sets.",
  "description": "Generate arithmetic questions, work through them in a study session, review the results, and keep a history of completed sessions. Settings control the difficulty of the operands.",
  "category": "productivity",
  "tags": ["practice", "arithmetic", "education"],
  "icon": "school",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "entry": {
    "type": "bundle",
    "route": "/app/math-practice",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/date-math": "0.1.0",
      "@lacuna/streak-calc": "0.1.0",
      "@lacuna/use-collection": "0.1.0",
      "@lacuna/heatmap": "0.1.0",
      "@lacuna/chart": "0.1.0",
      "@lacuna/date-picker": "0.1.0",
      "@lacuna/export-menu": "0.1.0",
      "@lacuna/json-backup": "0.1.0",
      "@lacuna/tracker-kit": "0.2.0"
    }
  },
  "capabilities": [
    "create:practice-session"
  ],
  "permissions": {
    "records": [
      {
        "kind": "practice-session",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store completed practice sessions"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "practice-session"
    ],
    "reads": [],
    "handoffs": []
  }
}
