{
  "manifestVersion": 1,
  "id": "lacuna.tetris",
  "name": "Classic Tetris",
  "version": "0.1.0",
  "summary": "Stack falling tetrominoes, clear lines, and chase the best score.",
  "description": "A 10 by 20 grid of falling tetrominoes. Move, rotate, and stack the pieces to clear horizontal lines. The score and the best score stay on this device, and a restart clears the board at any time.",
  "category": "personal",
  "icon": "grid",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "builtin",
    "route": "/app/tetris",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/board-grid": "0.1.0",
      "@lacuna/grid-utils": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/random": "0.1.0",
      "@lacuna/ui": "0.9.0",
      "@lacuna/use-hotkeys": "0.1.0",
      "@lacuna/use-local-record": "0.1.0",
      "@lacuna/use-timer": "0.1.0"
    }
  },
  "capabilities": [
    "create:game",
    "edit:score"
  ],
  "permissions": {
    "records": [
      {
        "kind": "game-state",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the game state and the best score between visits"
      }
    ],
    "platform": [
      "identity.profile.read"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "game-state"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts",
      "tests/engine.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
