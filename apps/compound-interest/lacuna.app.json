{
  "manifestVersion": 1,
  "id": "lacuna.compound-interest",
  "name": "Compound Interest Calc",
  "version": "0.1.0",
  "summary": "Grow a principal at a fixed annual rate and see the balance, the interest and a year-by-year breakdown.",
  "description": "Enter the principal, the annual rate, the number of years and the compounding frequency. The summary shows the final balance and the total interest earned; the breakdown splits the growth by year. The last calculation and a short history of saved scenarios persist across page reloads. Nothing leaves the browser.",
  "category": "productivity",
  "tags": ["compound-interest", "finance"],
  "icon": "finance",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "bundle",
    "route": "/app/compound-interest",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/chart": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0",
      "@lacuna/host-mock": "0.1.0"
    }
  },
  "capabilities": [
    "export:compound-interest"
  ],
  "permissions": {
    "records": [
      {
        "kind": "compound-interest",
        "access": [
          "read",
          "write",
          "create",
          "delete"
        ],
        "purpose": "Store the last compound interest calculation and the saved scenarios"
      }
    ],
    "platform": [
      "identity.profile.read",
      "clipboard.write"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [
      "financial"
    ],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "compound-interest"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
