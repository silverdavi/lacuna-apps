{
  "manifestVersion": 1,
  "id": "lacuna.bullet-journal",
  "name": "Bullet Journal",
  "version": "0.1.0",
  "summary": "A month grid and daily task list.",
  "description": "Pick a day on the month grid and keep a short list of tasks for it. Check tasks off as you go, reorder them, and watch the day's progress. The tasks stay on this device.",
  "category": "productivity",
  "tags": ["journal", "tasks", "planner"],
  "icon": "calendar",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "builtin",
    "route": "/app/bullet-journal",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/date-math": "0.1.0",
      "@lacuna/export-menu": "0.1.0",
      "@lacuna/heatmap": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/json-backup": "0.1.0",
      "@lacuna/streak-calc": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/tracker-kit": "0.2.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/use-collection": "0.1.0"
    }
  },
  "capabilities": [
    "edit:bullet-journal"
  ],
  "permissions": {
    "records": [
      {
        "kind": "bullet-journal",
        "access": [
          "read",
          "write",
          "create",
          "delete"
        ],
        "purpose": "Store the per-day task lists in this space's mock store"
      }
    ],
    "platform": [],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "bullet-journal"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
