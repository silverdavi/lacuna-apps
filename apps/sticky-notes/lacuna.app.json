{
  "manifestVersion": 1,
  "id": "lacuna.sticky-notes",
  "name": "Sticky Notes",
  "version": "0.1.0",
  "summary": "Jot quick notes: add, search, edit, reorder, and export. Nothing leaves the browser.",
  "description": "Keep a small list of sticky notes. Add a note, find one with search, edit its text, move one up and down, delete it, and export the whole list as JSON. The list survives reload. Nothing leaves the browser.",
  "category": "productivity",
  "tags": [],
  "icon": "notes",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/sticky-notes"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/json-backup": "0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/use-collection": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0"
    }
  },
  "capabilities": [
    "create:entry"
  ],
  "permissions": {
    "records": [
      {
        "kind": "entry",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the sticky notes"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "entry"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
