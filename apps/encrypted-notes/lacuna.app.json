{
  "manifestVersion": 1,
  "id": "lacuna.encrypted-notes",
  "name": "Encrypted Notes",
  "version": "0.1.0",
  "summary": "Private notes encrypted with a passphrase, stored locally.",
  "description": "Create, edit, and delete notes encrypted with a passphrase. Render Markdown, export to clipboard, and back up. Nothing leaves the browser.",
  "category": "productivity",
  "tags": [
    "notes",
    "privacy",
    "encryption"
  ],
  "icon": "docs",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/encrypted-notes"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "0.1.0",
      "@lacuna/ui": "0.1.0",
      "@lacuna/use-collection": "0.1.0",
      "@lacuna/record-table": "0.1.0",
      "@lacuna/record-form": "0.1.0",
      "@lacuna/filter-bar": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/search-box": "0.1.0",
      "@lacuna/confirm-dialog": "0.2.0",
      "@lacuna/tag-input": "0.1.0",
      "@lacuna/export-menu": "0.1.0",
      "@lacuna/json-backup": "0.1.0",
      "@lacuna/passphrase-crypto": "0.1.0",
      "@lacuna/markdown-to-html": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0"
    }
  },
  "capabilities": [
    "edit:encrypted-notes"
  ],
  "permissions": {
    "records": [
      {
        "kind": "note",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Own encrypted note records"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "note"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts",
      "tests/debug.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
