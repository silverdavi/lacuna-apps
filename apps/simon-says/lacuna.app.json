{
  "manifestVersion": 1,
  "id": "lacuna.simon-says",
  "name": "Simon Says",
  "version": "0.1.0",
  "summary": "A classic Simon Says memory game.",
  "description": "Watch the sequence of colored pads light up, then repeat it. Each round adds one more pad. Track your best streak across sessions.",
  "category": "personal",
  "tags": [],
  "icon": "grid",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/simon-says"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/random": "0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "create:game",
    "fill:game"
  ],
  "permissions": {
    "records": [
      {
        "kind": "game",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store best score and game history"
      }
    ],
    "platform": [],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "game"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
