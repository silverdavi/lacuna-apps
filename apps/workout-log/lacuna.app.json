{
  "manifestVersion": 1,
  "id": "lacuna.workout-log",
  "name": "Gym Workout Logger",
  "version": "0.1.0",
  "summary": "Log gym workouts with exercise, reps, weight, and sets; search, delete, and export to CSV.",
  "description": "A gym workout logger: add workouts with multiple exercises (name, reps, weight, sets), search by exercise, delete an exercise or a whole workout, view history, and export to CSV. Everything persists in the browser.",
  "category": "personal",
  "icon": "grid",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "builtin",
    "route": "/app/workout-log"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/chart": "0.1.0",
      "@lacuna/date-math": "0.1.0",
      "@lacuna/export-menu": "0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/heatmap": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/streak-calc": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/tracker-kit": "0.2.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/use-collection": "0.1.0"
    }
  },
  "capabilities": [
    "create:workout",
    "edit:workout",
    "export:csv"
  ],
  "permissions": {
    "records": [
      {
        "kind": "workout",
        "access": [
          "read",
          "write",
          "create",
          "delete"
        ],
        "purpose": "Store workouts and their exercises, reps, weight, and sets"
      }
    ],
    "platform": [
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "workout"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
