{
  "manifestVersion": 1,
  "id": "lacuna.regex-tester",
  "name": "Regex Tester",
  "version": "0.1.0",
  "summary": "Test regular expressions against sample text and keep a library of patterns.",
  "description": "Type a regular expression and sample text, read every match and capture group, and keep a library of patterns. Flags, flags presets, copy, and reload survive on the page. Nothing leaves the browser.",
  "category": "productivity",
  "icon": "search",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/regex-tester"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0"
    }
  },
  "capabilities": [
    "edit:regex"
  ],
  "permissions": {
    "records": [],
    "platform": [
      "identity.profile.read"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/00-setup.spec.ts",
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
