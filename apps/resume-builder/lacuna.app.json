{
  "manifestVersion": 1,
  "id": "lacuna.resume-builder",
  "name": "Resume Builder",
  "version": "0.1.0",
  "summary": "Compose a resume with name, contact, summary, skills, and experience, then export it as Markdown.",
  "description": "Enter your name, email, summary, skills, and work experience. Preview the resume in a clean layout. Export to a Markdown file. All data stays on this device and survives reloads.",
  "category": "productivity",
  "tags": ["resume", "markdown", "export", "builder"],
  "icon": "docs",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "bundle",
    "route": "/app/resume-builder",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/markdown-to-html": "0.1.0"
    }
  },
  "capabilities": [
    "edit:resume-builder"
  ],
  "permissions": {
    "records": [
      {
        "kind": "resume",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store resume details so they survive a reload"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "resume"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
