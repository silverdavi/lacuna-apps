{
  "manifestVersion": 1,
  "id": "lacuna.palette-generator",
  "name": "Color Palette",
  "version": "0.1.0",
  "summary": "Generate harmonious color palettes from a base color.",
  "description": "Pick a base color and a harmony scheme, generate a row of swatches, and copy or remove any of them. The hex and HSL fields stay in sync, and the active palette survives a reload.",
  "category": "productivity",
  "icon": "paint",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/palette-generator"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "create:palette",
    "edit:palette",
    "export:palette"
  ],
  "permissions": {
    "records": [
      {
        "kind": "palette",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the active palette so it survives a reload"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "palette"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
