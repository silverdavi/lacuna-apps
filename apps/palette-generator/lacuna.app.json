{
  "manifestVersion": 1,
  "id": "lacuna.palette-generator",
  "name": "Palette Generator",
  "version": "0.1.0",
  "summary": "Generate a five-swatch color palette from a base color using harmony schemes.",
  "description": "Pick a base color and a harmony scheme, generate a five-swatch palette, edit the base by hex or HSL, check WCAG contrast, copy and remove swatches, and export the palette. The palette and the base color are kept on this device.",
  "category": "productivity",
  "tags": [],
  "icon": "palette",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/palette-generator"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/color-math": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0",
      "@lacuna/codecs": "0.1.0",
      "@lacuna/text-transforms": "0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/use-local-record": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "create:color-palette"
  ],
  "permissions": {
    "records": [
      {
        "kind": "palette",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Keep the generated palette and its base color on this device"
      }
    ],
    "platform": [
      "clipboard.write",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "palette"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
