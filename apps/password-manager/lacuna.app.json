{
  "manifestVersion": 1,
  "id": "lacuna.password-manager",
  "name": "Password Manager",
  "version": "0.1.0",
  "summary": "Generate, store, and manage strong passwords locally.",
  "description": "Store site logins locally, generate strong passwords and passphrases, and copy them to the clipboard. Nothing leaves the browser.",
  "category": "productivity",
  "icon": "vault",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/password-manager"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/csv-parse": "0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/password-generate": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0"
    }
  },
  "capabilities": [
    "create:password",
    "view:password",
    "edit:password"
  ],
  "permissions": {
    "records": [
      {
        "kind": "password",
        "access": [
          "read",
          "write",
          "create",
          "delete"
        ],
        "purpose": "Store site login credentials locally"
      }
    ],
    "platform": [],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "password"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ]
  }
}
