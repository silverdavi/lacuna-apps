{
  "manifestVersion": 1,
  "id": "lacuna.whiteboard",
  "name": "Whiteboard",
  "version": "0.1.0",
  "summary": "Sketch on an infinite canvas with brush, eraser and layers, then export a PNG.",
  "description": "An infinite canvas for sketches. Draw with the brush, erase with the eraser, organize strokes into layers, undo and redo, and export the result as a PNG. The drawing state persists across reloads.",
  "category": "productivity",
  "icon": "whiteboard",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/whiteboard"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0",
      "@lacuna/use-local-record": "0.1.0"
    }
  },
  "capabilities": [
    "create:stroke",
    "create:layer",
    "export:png"
  ],
  "permissions": {
    "records": [
      {
        "kind": "canvas",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the strokes, layers, tool settings, and zoom level of the whiteboard"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "canvas"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
