{
  "manifestVersion": 1,
  "id": "lacuna.hebrew-calendar",
  "name": "Hebrew Calendar",
  "version": "0.1.0",
  "summary": "Convert Gregorian and Hebrew dates, see holidays, and find yahrzeit and anniversary dates.",
  "description": "Convert between Gregorian and Hebrew dates, browse a month calendar with holidays in either calendar, read the facts of a Hebrew year, and find the next dates of a Hebrew birthday, yahrzeit or bar and bat mitzvah. Everything is arithmetic on this device: no location, no network, no candle-lighting times. Anniversaries are saved as records and export to .ics.",
  "category": "personal",
  "icon": "calendar",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "bundle",
    "route": "/app/hebrew-calendar",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "0.1.0",
      "@lacuna/date-picker": "0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/ics-calendar": "0.1.0"
    }
  },
  "capabilities": [
    "create:hebrew-anniversary",
    "edit:hebrew-anniversary",
    "export:hebrew-anniversary"
  ],
  "permissions": {
    "records": [
      {
        "kind": "hebrew-anniversary",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the Hebrew birthdays, yahrzeits and mitzvah dates the person saves"
      }
    ],
    "platform": [
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "hebrew-anniversary"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "tags": [
    "hebrew",
    "calendar",
    "holidays",
    "yahrzeit",
    "convert"
  ]
}
