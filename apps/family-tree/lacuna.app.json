{
  "manifestVersion": 1,
  "id": "lacuna.family-tree",
  "name": "Family Tree Visualizer",
  "version": "0.1.0",
  "summary": "Build a family tree with a tree outline and a node graph.",
  "description": "Add people with a name and birth date, nest them as parent and child, and view the family as an indented tree outline or a node graph with edges. Auto-layout places each parent above their children. Export the tree as JSON or a CSV backup; the list is saved in this browser and survives a reload. Nothing leaves the browser.",
  "category": "personal",
  "tags": [],
  "icon": "people",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/family-tree"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/csv-parse": "0.1.0",
      "@lacuna/date-math": "0.1.0",
      "@lacuna/export-menu": "0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/json-backup": "0.1.0",
      "@lacuna/tree-outline": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "create:person",
    "edit:person",
    "export:person"
  ],
  "permissions": {
    "records": [
      {
        "kind": "person",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the name, birth date, and parent of each person"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "person"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
