{
  "manifestVersion": 1,
  "id": "lacuna.time-tracker",
  "name": "Time Tracker",
  "version": "0.1.0",
  "summary": "Time tasks with a start-stop clock and review every logged session.",
  "description": "Start the clock on a task, stop it when you are done, and watch the session land in your history. Track a running total, delete entries when they were logged in error, and export the log as CSV. Sessions stay in your space.",
  "category": "productivity",
  "tags": ["time", "timer", "sessions", "tracking"],
  "icon": "timesheets",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "bundle",
    "route": "/app/time-tracker",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/csv-parse": "0.1.0",
      "@lacuna/host-mock": "0.1.0"
    }
  },
  "capabilities": [
    "create:session",
    "edit:session",
    "export:csv"
  ],
  "permissions": {
    "records": [
      {
        "kind": "session",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Own Time Tracker sessions"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "time-tracker"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
