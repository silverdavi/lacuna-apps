{
  "manifestVersion": 1,
  "id": "lacuna.subscription-tracker",
  "name": "Subscription Tracker",
  "version": "0.1.0",
  "summary": "List your recurring bills and see what they cost each month.",
  "description": "List the subscriptions you pay for, each with a name, a category, and a monthly cost. See the total monthly spend. The list survives reload. Nothing leaves the browser.",
  "category": "productivity",
  "icon": "bills",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/subscription-tracker"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "create:subscription"
  ],
  "permissions": {
    "records": [
      {
        "kind": "subscription",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the name, category, and monthly cost of each subscription"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "subscription"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
