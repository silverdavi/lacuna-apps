{
  "manifestVersion": 1,
  "id": "lacuna.survey-app",
  "name": "Survey App",
  "version": "0.1.0",
  "summary": "Build surveys, collect checkbox responses, and export them to CSV.",
  "description": "Create named surveys, add questions, collect responses as checkboxes, review them in a table, and export to CSV. Surveys, questions, and responses survive reloads. Nothing leaves the device.",
  "category": "productivity",
  "tags": ["survey", "questions", "responses", "csv", "export"],
  "icon": "docs",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "builtin",
    "route": "/app/survey-app"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0"
    }
  },
  "capabilities": [
    "edit:survey-app"
  ],
  "permissions": {
    "records": [
      {
        "kind": "survey",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store surveys, their questions, and collected responses so they survive a reload"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "survey"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
