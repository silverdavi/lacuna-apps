{
  "manifestVersion": 1,
  "id": "lacuna.html-to-markdown",
  "name": "HTML Markdown Converter",
  "version": "0.1.0",
  "summary": "Convert HTML to Markdown and Markdown to HTML, with optional sanitization.",
  "description": "Paste HTML to get Markdown, or paste Markdown to get HTML. Headings, lists, links, and tables convert both ways. A sanitize switch strips scripts and event handlers from the HTML. Input and settings persist in this browser.",
  "category": "productivity",
  "tags": [
    "html",
    "markdown",
    "converter"
  ],
  "icon": "docs",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/html-to-markdown"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "0.1.0",
      "@lacuna/ui": "0.1.0",
      "@lacuna/html-to-markdown": "0.1.0",
      "@lacuna/markdown-to-html": "0.1.0",
      "@lacuna/code-area": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0",
      "@lacuna/use-local-record": "0.1.0",
      "@lacuna/file-save-open": "0.1.0"
    }
  },
  "capabilities": [
    "convert:html-markdown"
  ],
  "permissions": {
    "records": [
      {
        "kind": "html-to-markdown",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the last conversion input, direction, and sanitize setting"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "html-to-markdown"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
