{
  "manifestVersion": 1,
  "id": "lacuna.flashcards",
  "name": "Spaced Flashcards App",
  "version": "0.1.0",
  "summary": "Review cards in spaced decks.",
  "description": "Create decks of cards, add cards, and review the due cards. The SM-2 scheduler decides when each card comes back. The data stays on this device.",
  "category": "personal",
  "icon": "docs",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "bundle",
    "route": "/app/flashcards",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/date-math": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/spaced-repetition": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "edit:deck"
  ],
  "permissions": {
    "records": [
      {
        "kind": "deck",
        "access": [
          "read",
          "write",
          "create",
          "delete"
        ],
        "purpose": "Store the decks and the cards in each"
      }
    ],
    "platform": [],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "deck"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
