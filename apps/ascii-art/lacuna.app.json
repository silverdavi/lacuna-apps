{
  "manifestVersion": 1,
  "id": "lacuna.ascii-art",
  "name": "ASCII Art Generator",
  "version": "0.1.0",
  "summary": "Turn text or images into ASCII art with a choice of character sets.",
  "description": "Type text or upload an image, pick a character set and width, and generate ASCII art. Copy the result to the clipboard or download it as a text file. The last generated art survives reload. Nothing leaves the browser.",
  "category": "productivity",
  "icon": "paint",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/ascii-art"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/combobox": "0.1.0",
      "@lacuna/code-area": "0.1.0",
      "@lacuna/codecs": "0.1.0",
      "@lacuna/text-transforms": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/use-local-record": "0.1.0"
    }
  },
  "capabilities": [
    "edit:ascii-art"
  ],
  "permissions": {
    "records": [
      {
        "kind": "ascii-art",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the last generated ASCII art between visits"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "ascii-art"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
