{
  "manifestVersion": 1,
  "id": "lacuna.archive-converter",
  "name": "Archive Studio",
  "version": "0.1.0",
  "summary": "Inspect, extract, pack, and convert ZIP, TAR, and TAR.GZ archives offline.",
  "description": "Open ZIP, TAR, TAR.GZ, or GZIP archives to inspect contained files, preview text entries inline, extract individual files, or repack and convert archives between ZIP, TAR, and TAR.GZ completely offline.",
  "category": "productivity",
  "tags": ["converter", "conversion-suite", "archive", "zip", "tar", "gzip", "compress"],
  "icon": "folder",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "bundle",
    "route": "/app/archive-converter",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/use-local-record": "0.1.0"
    }
  },
  "capabilities": [
    "convert:zip->tar",
    "convert:tar->zip",
    "edit:archive-converter"
  ],
  "permissions": {
    "records": [
      {
        "kind": "archive-converter",
        "access": ["read", "write", "create"],
        "purpose": "Store recent archive conversions and preferred output format across reloads"
      }
    ],
    "platform": ["files.pick", "files.save"],
    "network": { "origins": [] },
    "dataClasses": [],
    "availability": { "spaceTypes": ["any"] }
  },
  "sharing": {
    "owns": ["archive-converter"],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": ["tests/acceptance.spec.ts"],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
