{
  "manifestVersion": 1,
  "id": "lacuna.game-2048",
  "name": "2048 Game",
  "version": "0.1.0",
  "summary": "Slide and merge tiles on a 4 by 4 grid to reach 2048.",
  "description": "A number-merging puzzle on a 4 by 4 grid. Slide tiles with the arrow keys, merge matching numbers to build the 2048 tile, and keep a running score against a best score. The board, the score, and the best score stay on this device.",
  "category": "personal",
  "icon": "grid",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "builtin",
    "route": "/app/game-2048"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "create:game",
    "edit:score"
  ],
  "permissions": {
    "records": [
      {
        "kind": "game-state",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the board, the score, and the best score between visits"
      }
    ],
    "platform": [
      "identity.profile.read"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "game-state"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
