{
  "manifestVersion": 1,
  "id": "lacuna.photo-gallery",
  "name": "Local Photo Gallery",
  "version": "0.1.0",
  "summary": "Collect, view, reorder, rotate and export photos that stay on this device.",
  "description": "Drop or browse for photos to build a personal grid. Open any photo in a lightbox, rotate it 90 degrees, and export it back out as a file. Drag photos to reorder them. Everything is kept on this device, so the gallery survives a reload. Nothing leaves the browser.",
  "category": "productivity",
  "tags": ["photo", "gallery", "image", "rotate", "export"],
  "icon": "paint",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "bundle",
    "route": "/app/photo-gallery",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/before-after": "0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/image-ops": "0.1.0",
      "@lacuna/range-slider": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0",
      "@lacuna/use-drag-reorder": "0.1.0",
      "@lacuna/use-local-record": "0.1.0"
    }
  },
  "capabilities": [
    "view:image",
    "edit:image"
  ],
  "permissions": {
    "records": [
      {
        "kind": "photo-gallery-collection",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Keep the gallery photos, their order and applied rotations on this device"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "photo-gallery-collection"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
