{
  "manifestVersion": 1,
  "id": "lacuna.form-builder",
  "name": "Dynamic Form Builder",
  "version": "0.1.0",
  "summary": "Build, fill, and export dynamic forms offline.",
  "description": "Create named forms, add fields with labels, types, and required flags, preview them as a fill view, submit with validation, and export the response as JSON. Forms and their fields survive reloads. Nothing leaves the device.",
  "category": "productivity",
  "tags": ["forms", "builder", "dynamic", "json", "export", "validation"],
  "icon": "docs",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "builtin",
    "route": "/app/form-builder"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0"
    }
  },
  "capabilities": [
    "edit:form-builder"
  ],
  "permissions": {
    "records": [
      {
        "kind": "form",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store built forms and their fields so they survive a reload"
      }
    ],
    "platform": [
      "identity.profile.read"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "form"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
