{
  "manifestVersion": 1,
  "id": "lacuna.birthday-reminder",
  "name": "Birthday Reminder",
  "version": "0.1.0",
  "summary": "Track birthdays with reminders, a calendar view, search, and CSV export.",
  "description": "Add people with a name, birth date, and optional notes. Browse the list, jump to a calendar view that highlights each birthday, set a reminder lead time, and export the list as CSV. Birthdays are saved in this browser and survive a reload. Nothing leaves the browser.",
  "category": "personal",
  "tags": [],
  "icon": "calendar",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "bundle",
    "route": "/app/birthday-reminder",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/csv-parse": "0.1.0",
      "@lacuna/date-picker": "0.1.0",
      "@lacuna/export-menu": "0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/heatmap": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/json-backup": "0.1.0",
      "@lacuna/use-reminder": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "create:birthday",
    "edit:birthday",
    "export:birthday"
  ],
  "permissions": {
    "records": [
      {
        "kind": "birthday",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the name, birth date, and notes of each person"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "birthday"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
