{
  "manifestVersion": 1,
  "id": "lacuna.todo-list",
  "name": "Simple Todo List",
  "version": "0.1.0",
  "summary": "Add, complete, and reorder daily tasks with optional due dates.",
  "description": "A single list of tasks with titles and optional due dates. Add a task, check it off, drag it to reorder, and delete it when it is done. The list persists locally across sessions.",
  "category": "productivity",
  "tags": [],
  "icon": "tasks",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/todo-list"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/confirm-dialog": "0.2.0",
      "@lacuna/export-menu": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/json-backup": "0.1.0",
      "@lacuna/use-collection": "0.1.0",
      "@lacuna/use-drag-reorder": "0.1.0"
    }
  },
  "capabilities": [
    "create:todo",
    "edit:todo",
    "export:todo"
  ],
  "permissions": {
    "records": [
      {
        "kind": "todo",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the task list: titles, due dates, completion, and order"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "todo"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
