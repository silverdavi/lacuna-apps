{
  "manifestVersion": 1,
  "id": "lacuna.mortgage-calculator",
  "name": "Mortgage Calculator",
  "version": "0.1.0",
  "summary": "Estimate the monthly payment, total interest, and payoff timeline for a home loan.",
  "description": "Enter the loan amount, interest rate, term, and down payment. The calculator shows the monthly payment, total interest, the financed loan amount, a year-by-year breakdown of principal and interest, and a chart of the annual interest share. The last calculation survives a reload.",
  "category": "productivity",
  "icon": "finance",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/mortgage-calculator"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "create:mortgage"
  ],
  "permissions": {
    "records": [
      {
        "kind": "mortgage",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the last mortgage calculation"
      }
    ],
    "platform": [
      "identity.profile.read"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "mortgage"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
