{
  "manifestVersion": 1,
  "id": "lacuna.hash-generator",
  "name": "Hash Generator",
  "version": "0.1.0",
  "summary": "Hash text with SHA-1, SHA-256, or SHA-512 and encode the result as hex, base64, or url.",
  "description": "Enter text, pick an algorithm and an encoding, and get the digest instantly. Copy the result or keep it in a local history table. Nothing leaves the browser.",
  "category": "productivity",
  "tags": [],
  "icon": "security",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "bundle",
    "route": "/app/hash-generator",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0"
    }
  },
  "capabilities": [
    "view:hash",
    "create:hash"
  ],
  "permissions": {
    "records": [
      {
        "kind": "hash",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Keep the recent hash history on this device"
      }
    ],
    "platform": [
      "identity.profile.read"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "hash"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
