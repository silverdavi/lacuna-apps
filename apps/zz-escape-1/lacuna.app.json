{
  "manifestVersion": 1,
  "id": "lacuna.zz-escape-1",
  "name": "Budget Planner",
  "version": "0.1.0",
  "summary": "Plan a month's money: list income and expenses, see what is left.",
  "description": "List the income and expenses of a month, each with a description and an amount. See total income, total expenses, and the balance. The list survives reload. Nothing leaves the browser.",
  "category": "productivity",
  "icon": "grid",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/zz-escape-1"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "create:entry"
  ],
  "permissions": {
    "records": [
      {
        "kind": "entry",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the income and expense entries of a month"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "entry"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
