{
  "manifestVersion": 1,
  "id": "lacuna.mind-map",
  "name": "Mind Map",
  "version": "0.1.0",
  "summary": "A small mind-map board for ideas, links and sketches.",
  "description": "Add idea nodes, rename them, connect them into a map, freehand annotations on the canvas with a brush or an eraser, auto layout, and PNG export. The map and the sketch survive a reload.",
  "category": "productivity",
  "tags": ["mindmap", "ideas", "diagram"],
  "icon": "whiteboard",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "builtin",
    "route": "/app/mind-map"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/range-slider": "0.1.0",
      "@lacuna/use-pointer-draw": "0.1.0"
    }
  },
  "capabilities": [
    "edit:mind-map"
  ],
  "permissions": {
    "records": [
      {
        "kind": "mind-map",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the map nodes, connections and canvas strokes so they survive a reload"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "mind-map"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
