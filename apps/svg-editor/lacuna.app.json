{
  "manifestVersion": 1,
  "id": "lacuna.svg-editor",
  "name": "SVG Editor",
  "version": "0.1.0",
  "summary": "A vector editor with layers, a brush, shapes, and PNG export.",
  "description": "Add layers, pick a tool, and draw brush strokes, rectangles, and ellipses. Adjust the stroke width and the canvas size, undo mistakes, and export the result as a PNG. The document survives a reload.",
  "category": "productivity",
  "tags": ["vector", "svg", "sketch", "shape"],
  "icon": "design",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "builtin",
    "route": "/app/svg-editor"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/use-undo-stack": "0.1.0",
      "@lacuna/file-save-open": "0.1.0"
    }
  },
  "capabilities": [
    "edit:svg-editor"
  ],
  "permissions": {
    "records": [
      {
        "kind": "svg-editor",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the document, layers, and canvas settings so they survive a reload"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "svg-editor"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
