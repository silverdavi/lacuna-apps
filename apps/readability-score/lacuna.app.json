{
  "manifestVersion": 1,
  "id": "lacuna.readability-score",
  "name": "Text Readability Score",
  "version": "0.1.0",
  "summary": "Score any passage with word, sentence and character counts plus Flesch and Gunning Fog readability.",
  "description": "Paste or type a passage and read its counts and readability scores: word, sentence, paragraph and character counts, Flesch Reading Ease, Flesch-Kincaid Grade Level, an optional Gunning Fog row, a copyable report, a .txt download and a history of recent analyses.",
  "category": "productivity",
  "tags": [],
  "icon": "docs",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "builtin",
    "route": "/app/readability-score",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/text-stats": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/use-clipboard": "0.1.0",
      "@lacuna/use-local-record": "0.1.0"
    }
  },
  "capabilities": [
    "create:analysis",
    "export:report"
  ],
  "permissions": {
    "records": [
      {
        "kind": "readability-score",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the editor text, options and the history of analyses between visits"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "readability-score"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
