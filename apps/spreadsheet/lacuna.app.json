{
  "manifestVersion": 1,
  "id": "lacuna.spreadsheet",
  "name": "Spreadsheet",
  "version": "0.1.0",
  "summary": "Multi-sheet workbook with a formula engine, cell formatting, sorting, and CSV import and export.",
  "description": "A multi-sheet spreadsheet with a recursive-descent formula engine supporting 35+ functions, ranges, cross-sheet references, cycle detection, cell formatting, row and column operations, sorting, undo and redo, workbook templates, and CSV and JSON import and export.",
  "category": "productivity",
  "icon": "sheets",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "bundle",
    "route": "/app/spreadsheet",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "0.1.0",
      "@lacuna/csv-parse": "0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/use-undo-stack": "0.1.0"
    }
  },
  "capabilities": [
    "create:spreadsheet",
    "edit:spreadsheet",
    "export:csv"
  ],
  "permissions": {
    "records": [
      {
        "kind": "spreadsheet",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store multi-sheet workbooks, cell formulas, and formatting preferences"
      }
    ],
    "platform": [
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "spreadsheet"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "tags": [
    "spreadsheet",
    "formulas",
    "workbook",
    "csv",
    "tables"
  ]
}
