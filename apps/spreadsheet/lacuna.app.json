{
  "manifestVersion": 1,
  "id": "lacuna.spreadsheet",
  "name": "Spreadsheet App",
  "version": "0.1.0",
  "summary": "A small grid of cells with formulas, multiple sheets, and CSV export.",
  "description": "Type numbers or formulas like =A1*2 into a grid of cells. Add sheets, switch between them, and export the current sheet to CSV. Everything stays on this device and survives a reload.",
  "category": "productivity",
  "icon": "sheets",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/spreadsheet"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0",
      "@lacuna/csv-parse": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "create:sheet",
    "edit:sheet"
  ],
  "permissions": {
    "records": [
      {
        "kind": "sheet",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the sheets and their cell values"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "sheet"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
