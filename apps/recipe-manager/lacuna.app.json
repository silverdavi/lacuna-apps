{
  "manifestVersion": 1,
  "id": "lacuna.recipe-manager",
  "name": "Recipe Manager",
  "version": "0.1.0",
  "summary": "Keep a list of recipes with servings, notes and tags.",
  "description": "One list of recipes. Add, edit, delete, search, sort and export. Nothing leaves the browser.",
  "category": "personal",
  "tags": ["recipes", "cooking", "notes"],
  "icon": "notes",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/recipe-manager"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/use-collection": "0.1.0",
      "@lacuna/record-table": "0.1.0",
      "@lacuna/record-form": "0.1.0",
      "@lacuna/filter-bar": "0.1.0",
      "@lacuna/search-box": "0.1.0",
      "@lacuna/confirm-dialog": "0.2.0",
      "@lacuna/tag-input": "0.1.0",
      "@lacuna/export-menu": "0.1.0",
      "@lacuna/json-backup": "0.1.0",
      "@lacuna/host-mock": "0.1.0"
    }
  },
  "capabilities": [
    "create:recipe"
  ],
  "permissions": {
    "records": [
      {
        "kind": "recipe",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store recipe records with servings, notes and tags"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "recipe"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
