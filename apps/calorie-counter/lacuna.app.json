{
  "manifestVersion": 1,
  "id": "lacuna.calorie-counter",
  "name": "Calorie Counter",
  "version": "0.1.0",
  "summary": "Log meals, track daily calories, and export your intake.",
  "description": "A simple calorie counter. Log each meal with its category and calories, sort and filter by category, see your daily total and mean, and export the log as CSV. Nothing leaves the browser.",
  "category": "healthcare",
  "tags": ["health", "nutrition", "tracker"],
  "icon": "analytics",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "bundle",
    "route": "/app/calorie-counter",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/host-mock": "0.1.0"
    }
  },
  "capabilities": [
    "edit:calorie-counter"
  ],
  "permissions": {
    "records": [
      {
        "kind": "calorie-counter",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Own Calorie Counter meal records"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "calorie-counter"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
