{
  "manifestVersion": 1,
  "id": "lacuna.trip-cost",
  "name": "Trip Cost Calculator",
  "version": "0.1.0",
  "summary": "Calculate fuel costs for road trips and save them for later.",
  "description": "Enter distance, MPG, and fuel price to get total cost and gallons needed. Save trips to keep a history.",
  "category": "productivity",
  "tags": [],
  "icon": "finance",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "bundle",
    "route": "/app/trip-cost",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/money": "0.1.0",
      "@lacuna/number-input": "0.1.0",
      "@lacuna/ui": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0",
      "@lacuna/use-local-record": "0.1.0"
    }
  },
  "capabilities": [
    "edit:trip-cost"
  ],
  "permissions": {
    "records": [
      {
        "kind": "trip-cost",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store saved trip calculations"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "trip-cost"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
