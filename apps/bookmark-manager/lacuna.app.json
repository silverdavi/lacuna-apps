{
  "manifestVersion": 1,
  "id": "lacuna.bookmark-manager",
  "name": "Bookmark Manager",
  "version": "0.1.0",
  "summary": "Collect, search, sort, and export bookmarks.",
  "description": "Save the pages you want to come back to. Add each bookmark with a title, URL, and tags, then search by title, URL, or tag, sort by any column, edit or delete rows, and export the ones you pick as CSV. The list is saved in this browser and survives a reload. Nothing leaves the browser.",
  "category": "productivity",
  "icon": "docs",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "bundle",
    "route": "/app/bookmark-manager",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/csv-parse": "0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "create:bookmark",
    "edit:bookmark",
    "export:bookmark"
  ],
  "permissions": {
    "records": [
      {
        "kind": "bookmark",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the title, URL, and tags of each bookmark"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "bookmark"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
