{
  "manifestVersion": 1,
  "id": "lacuna.mastermind",
  "name": "Mastermind Game",
  "version": "0.1.0",
  "summary": "Crack a four-peg color code in as few guesses as you can.",
  "description": "A seeded mastermind board. Pick four pegs, submit a guess, and read the black-and-white pegs back until the hidden code gives up. The best score survives reloads; undo and redo walk the guess history; copy the result sends the seed, the code, and the guess count to the clipboard.",
  "category": "personal",
  "tags": [],
  "icon": "grid",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "bundle",
    "route": "/app/mastermind",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/random": "0.1.0",
      "@lacuna/ui": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0",
      "@lacuna/use-undo-stack": "0.1.0"
    }
  },
  "capabilities": [
    "create:game",
    "edit:game",
    "export:game"
  ],
  "permissions": {
    "records": [
      {
        "kind": "game",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the best score across sessions"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "game"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
