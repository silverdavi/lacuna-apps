{
  "manifestVersion": 1,
  "id": "lacuna.typing-test",
  "name": "Typing Test",
  "version": "0.1.0",
  "summary": "Measure typing speed and accuracy with timed tests.",
  "description": "A generated passage, a text area, and a timer. Type the passage and receive a final score of words per minute and accuracy. The test state and the best score survive a reload.",
  "category": "productivity",
  "tags": ["typing", "speed", "accuracy"],
  "icon": "tasks",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "bundle",
    "route": "/app/typing-test",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "create:test",
    "edit:test"
  ],
  "permissions": {
    "records": [
      {
        "kind": "test",
        "access": [
          "read",
          "create"
        ],
        "purpose": "Create a typing test and record its score and best WPM"
      }
    ],
    "platform": [
      "identity.profile.read"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "test"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts",
      "tests/typing.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
