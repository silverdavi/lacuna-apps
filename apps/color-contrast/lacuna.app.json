{
  "manifestVersion": 1,
  "id": "lacuna.color-contrast",
  "name": "Color Contrast Checker",
  "version": "0.1.0",
  "summary": "Check WCAG contrast between two colors and save pairs.",
  "description": "Enter a foreground and a background color, read the WCAG contrast ratio and level, generate a palette from the background color, and keep a list of saved pairs. All color math happens in the browser; nothing leaves the page.",
  "category": "productivity",
  "tags": [],
  "icon": "paint",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "bundle",
    "route": "/app/color-contrast",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/color-math": "0.1.0",
      "@lacuna/combobox": "0.1.0",
      "@lacuna/code-area": "0.1.0",
      "@lacuna/codecs": "0.1.0",
      "@lacuna/text-transforms": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/use-local-record": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "view:color-pair",
    "create:color-pair"
  ],
  "permissions": {
    "records": [
      {
        "kind": "color-contrast-pair",
        "access": [
          "read",
          "write",
          "create",
          "delete"
        ],
        "purpose": "Own the list of saved color pairs"
      }
    ],
    "platform": [
      "clipboard.write"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "color-contrast-pair"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "license": "MIT"
  }
}
