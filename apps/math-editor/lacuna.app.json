{
  "manifestVersion": 1,
  "id": "lacuna.math-editor",
  "name": "Math Editor",
  "version": "0.1.0",
  "summary": "Write Markdown and TeX, preview it, copy it, export it.",
  "description": "A Markdown and TeX editor with a live preview, copy-to-clipboard, HTML export, and an autosaved history of snapshots. Nothing leaves the browser.",
  "category": "productivity",
  "icon": "docs",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/math-editor"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/code-area": "0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/markdown-to-html": "0.1.0",
      "@lacuna/ui": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0"
    }
  },
  "capabilities": [
    "edit:math-editor"
  ],
  "permissions": {
    "records": [
      {
        "kind": "math-editor",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the document source and autosaved history snapshots"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "math-editor"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
