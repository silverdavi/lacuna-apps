{
  "manifestVersion": 1,
  "id": "lacuna.event-planner",
  "name": "Event Planner",
  "version": "0.1.0",
  "summary": "Plan events on a month calendar, track tasks on a timeline, and export everything to .ics.",
  "description": "Manage personal events and project tasks. Create, view, and delete events on a month calendar grid with optional weekly, monthly, or yearly recurrence. Track project tasks on a Gantt-style timeline with drag-to-resize bars. Export events or tasks as iCalendar (.ics) files. Everything stays on this device.",
  "category": "productivity",
  "tags": [],
  "icon": "calendar",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/event-planner"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/date-math": "0.1.0",
      "@lacuna/ics-calendar": "0.1.0",
      "@lacuna/recurrence": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0",
      "@lacuna/host-mock": "0.1.0"
    }
  },
  "capabilities": [
    "edit:event-planner"
  ],
  "permissions": {
    "records": [
      {
        "kind": "event",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store events and tasks"
      }
    ],
    "platform": [],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "event"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
