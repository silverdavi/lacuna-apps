{
  "manifestVersion": 1,
  "id": "lacuna.markdown-table",
  "name": "Markdown table",
  "version": "0.1.0",
  "summary": "Turn a pipe table into rows you can read down the page.",
  "description": "Paste a markdown pipe table. The page splits each row on the pipes and shows the cells in a table. A separator row of dashes is skipped.",
  "category": "productivity",
  "icon": "sheets",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/markdown-table"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/use-local-record": "0.1.0"
    }
  },
  "capabilities": [
    "edit:markdown"
  ],
  "permissions": {
    "records": [
      {
        "kind": "markdown-table",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the pipe-table source and the rows parsed from it"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "markdown-table"
    ],
    "reads": [],
    "handoffs": []
  }
}
