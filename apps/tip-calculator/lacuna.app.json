{
  "manifestVersion": 1,
  "id": "lacuna.tip-calculator",
  "name": "Tip Calculator",
  "version": "0.1.0",
  "summary": "Split a bill, pick a tip, share per-person totals.",
  "description": "A personal tip calculator. Enter a bill amount, set a tip percent or amount, choose how many people split it, and get a per-person share plus the total to pay. Results copy to the clipboard with one tap. Data is local to the device; nothing leaves it.",
  "category": "personal",
  "tags": [],
  "icon": "bills",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "builtin",
    "route": "/app/tip-calculator"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/money": "0.1.0",
      "@lacuna/money-input": "0.1.0",
      "@lacuna/number-input": "0.1.0",
      "@lacuna/ui": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0",
      "@lacuna/host-mock": "0.1.0"
    }
  },
  "capabilities": [
    "create:tip-calculation"
  ],
  "permissions": {
    "records": [
      {
        "kind": "tip-scenario",
        "access": [
          "read",
          "write",
          "create",
          "delete"
        ],
        "purpose": "Store named tip calculations the user wants to keep."
      }
    ],
    "platform": [
      "clipboard.write"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "tip-scenario"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}