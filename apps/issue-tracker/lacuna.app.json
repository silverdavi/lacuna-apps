{
  "manifestVersion": 1,
  "id": "lacuna.issue-tracker",
  "name": "Bug Issue Tracker",
  "version": "0.1.0",
  "summary": "Log bugs and features, then sort, filter, and export them.",
  "description": "Track the bugs and features you are chasing. Add each issue with a title, type, priority, assignee, and status, then sort by priority, filter by search, type, or status, and track work in a board view. The list is saved in this browser and survives a reload. Export the table as CSV or a JSON backup, and restore from a backup any time. Nothing leaves the browser.",
  "category": "productivity",
  "icon": "tasks",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/issue-tracker"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/csv-parse": "0.1.0",
      "@lacuna/export-menu": "0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/json-backup": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "create:issue",
    "edit:issue",
    "export:issue",
    "import:issue"
  ],
  "permissions": {
    "records": [
      {
        "kind": "issue",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the title, type, priority, assignee, and status of each issue"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "issue"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
