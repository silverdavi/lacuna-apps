{
  "manifestVersion": 1,
  "id": "lacuna.unit-converter",
  "name": "Unit Converter",
  "version": "0.1.0",
  "summary": "Convert length, mass, volume, temperature, and area.",
  "description": "Pick a category, type in either field, and see the other update. Recent conversions are kept on this page. Nothing leaves the browser.",
  "category": "productivity",
  "tags": [],
  "icon": "grid",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/unit-converter"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "create:conversion"
  ],
  "permissions": {
    "records": [
      {
        "kind": "conversion",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Keep the list of recent conversions"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "conversion"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
