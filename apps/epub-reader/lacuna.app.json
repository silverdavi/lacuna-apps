{
  "manifestVersion": 1,
  "id": "lacuna.epub-reader",
  "name": "EPUB Reader",
  "version": "0.1.0",
  "summary": "Open an EPUB, read it page by page, and keep bookmarks.",
  "description": "A paged reader for EPUB files. Open a book, turn pages, adjust the type, mark pages, and copy a page's text. The position and bookmarks are the records. Nothing leaves the browser.",
  "category": "productivity",
  "icon": "docs",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "builtin",
    "route": "/app/epub-reader"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/ui": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/paged-reader": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0",
      "@lacuna/use-local-record": "0.1.0"
    }
  },
  "capabilities": [
    "view:epub",
    "export:text"
  ],
  "permissions": {
    "records": [
      {
        "kind": "epub-reader",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the open book, the current page, and the bookmarked pages"
      }
    ],
    "platform": [
      "files.pick"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "epub-reader"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ]
  }
}
