{
  "manifestVersion": 1,
  "id": "lacuna.pantry-inventory",
  "name": "Pantry Inventory",
  "version": "0.1.0",
  "summary": "Track what's in your pantry, with quantities and expiration dates.",
  "description": "Keep one list of pantry items. Add items with a quantity, unit, and optional expiration date. Filter by status, search by name, export to CSV, and delete items. Everything stays on this device.",
  "category": "personal",
  "tags": ["pantry", "inventory", "food", "household"],
  "icon": "folder",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "bundle",
    "route": "/app/pantry-inventory",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/use-collection": "0.1.0",
      "@lacuna/csv-parse": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0"
    }
  },
  "capabilities": [
    "create:pantry-item",
    "edit:pantry-item",
    "export:pantry-item"
  ],
  "permissions": {
    "records": [
      {
        "kind": "pantry-item",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Own pantry inventory items"
      }
    ],
    "platform": [
      "identity.profile.read"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "pantry-inventory"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
