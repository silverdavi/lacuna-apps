{
  "manifestVersion": 1,
  "id": "lacuna.point-of-sale",
  "name": "Point of Sale",
  "version": "0.1.0",
  "summary": "A point-of-sale app with sales and inventory management.",
  "description": "Track sales with line items, discounts, and tax. Manage inventory with stock levels and pricing. Export sales to CSV. Data persists locally.",
  "category": "business",
  "tags": ["sales", "inventory", "pos"],
  "icon": "storefront",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/point-of-sale"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "create:sale",
    "edit:inventory",
    "export:sales"
  ],
  "permissions": {
    "records": [
      {
        "kind": "point-of-sale",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Own point-of-sale records"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "point-of-sale"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
