{
  "manifestVersion": 1,
  "id": "lacuna.vocabulary-builder",
  "name": "Vocabulary Builder",
  "version": "0.1.0",
  "summary": "Build a deck of words and review them with spaced repetition.",
  "description": "Add words with their definitions, review the due cards in a study session, grade each card as Again or Good, and watch the deck learn. Export the whole deck as CSV to the clipboard. Everything stays on this device.",
  "category": "productivity",
  "tags": [
    "vocabulary",
    "flashcards",
    "study"
  ],
  "icon": "notes",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "builtin",
    "route": "/app/vocabulary-builder"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/spaced-repetition": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/csv-parse": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0"
    }
  },
  "capabilities": [
    "create:word",
    "edit:word",
    "export:csv"
  ],
  "permissions": {
    "records": [
      {
        "kind": "word",
        "access": [
          "read",
          "write",
          "create",
          "delete"
        ],
        "purpose": "Store the words and definitions the user adds"
      }
    ],
    "platform": [],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "word"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
