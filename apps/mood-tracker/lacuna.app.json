{
  "manifestVersion": 1,
  "id": "lacuna.mood-tracker",
  "name": "Mood Tracker",
  "version": "0.1.0",
  "summary": "Log a daily mood, then watch the heatmap and trend.",
  "description": "One mood and a note per day. A heatmap of the last seven days and a trend line spot the pattern. The log stays on this device.",
  "category": "personal",
  "tags": ["mood", "wellbeing", "trends"],
  "icon": "analytics",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "bundle",
    "route": "/app/mood-tracker",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/chart": "0.1.0",
      "@lacuna/csv-parse": "0.1.0",
      "@lacuna/date-math": "0.1.0",
      "@lacuna/export-menu": "0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/heatmap": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/json-backup": "0.1.0",
      "@lacuna/streak-calc": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "create:mood-entry",
    "view:heatmap",
    "view:trend",
    "export:backup"
  ],
  "permissions": {
    "records": [
      {
        "kind": "mood-entry",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the mood logged for each day"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "mood-entry"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
