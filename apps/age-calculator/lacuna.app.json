{
  "manifestVersion": 1,
  "id": "lacuna.age-calculator",
  "name": "Age Calculator",
  "version": "0.1.0",
  "summary": "Exact age in years, months and days.",
  "description": "Enter a birth date and an optional reference date. See the age in years, months and days, a breakdown of the totals, and a small chart. The last calculation is kept across reloads. Nothing leaves the browser.",
  "category": "productivity",
  "tags": [],
  "icon": "calendar",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/age-calculator"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "calculate:age"
  ],
  "permissions": {
    "records": [
      {
        "kind": "age-calculation",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the birth date, the reference date and the last calculated age"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "age-calculation"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
