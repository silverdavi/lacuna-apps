{
  "manifestVersion": 1,
  "id": "lacuna.virtual-piano",
  "name": "Virtual Piano",
  "version": "0.1.0",
  "summary": "A small on-screen piano keyboard that records the notes you play.",
  "description": "Press the white keys or type the keyboard letters and every note lands in a recorded list with a live count. A metronome toggle sets the tempo with BPM controls, and a History tab keeps the last 50 notes in a table that can be copied or exported. The note list survives a reload. Nothing leaves the browser.",
  "category": "personal",
  "tags": [
    "music",
    "keyboard",
    "metronome"
  ],
  "icon": "grid",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/virtual-piano"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/host-mock": "0.1.0"
    }
  },
  "capabilities": [
    "create:note"
  ],
  "permissions": {
    "records": [
      {
        "kind": "note",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the notes played on the keyboard"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "note"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
