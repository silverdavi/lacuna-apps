{
  "manifestVersion": 1,
  "id": "lacuna.morse-code",
  "name": "Morse Code Translator",
  "version": "0.1.0",
  "summary": "Translate text to International Morse Code and back.",
  "description": "Type text and read its International Morse Code, or type dots and dashes and read the text. Copy the result to the clipboard and review past conversions in the history, which is kept on this device. Nothing leaves the browser.",
  "category": "productivity",
  "tags": [
    "morse",
    "translator",
    "encode",
    "decode"
  ],
  "icon": "docs",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "bundle",
    "route": "/app/morse-code",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/use-clipboard": "0.1.0"
    }
  },
  "capabilities": [
    "create:conversion"
  ],
  "permissions": {
    "records": [
      {
        "kind": "conversion",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the text converted to Morse Code and back"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "conversion"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
