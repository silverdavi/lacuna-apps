{
  "manifestVersion": 1,
  "id": "lacuna.reaction-time",
  "name": "Reaction Time Test",
  "version": "0.1.0",
  "summary": "Time how fast you react to a green cue.",
  "description": "Tap Start trial, wait for the cue to turn green, and click the moment it does. Each reaction is recorded in ms with a timestamp, and the best and average show on the Stats tab. The history stays on this device and survives a reload. Nothing leaves the browser.",
  "category": "personal",
  "tags": ["reaction", "speed", "test"],
  "icon": "analytics",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "builtin",
    "route": "/app/reaction-time"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/host-mock": "0.1.0"
    }
  },
  "capabilities": [
    "create:reaction",
    "view:reaction"
  ],
  "permissions": {
    "records": [
      {
        "kind": "reaction",
        "access": [
          "read",
          "create",
          "delete"
        ],
        "purpose": "Store recorded reaction times with timestamps"
      }
    ],
    "platform": [
      "clipboard.write"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "reaction"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
