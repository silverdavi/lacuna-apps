{
  "manifestVersion": 1,
  "id": "lacuna.json-schema",
  "name": "JSON Schema Validator",
  "version": "0.1.0",
  "summary": "Validate JSON data against a draft-07 schema, see the errors, and download a report.",
  "description": "Paste a JSON document and a JSON Schema, run the validation, and see a list of specific errors or a pass. The last inputs and result survive a reload. The report downloads as a file. Nothing leaves the browser.",
  "category": "productivity",
  "icon": "security",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "builtin",
    "route": "/app/json-schema"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "edit:validation"
  ],
  "permissions": {
    "records": [
      {
        "kind": "validation",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the last validated data, schema, and result"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "validation"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
