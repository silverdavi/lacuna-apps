{
  "manifestVersion": 1,
  "id": "lacuna.base64-tool",
  "name": "Base64 Tool",
  "version": "0.1.0",
  "summary": "Encode and decode text as Base64, URL-safe Base64, or Hex.",
  "description": "Type text and read its Base64, URL-safe Base64, or Hex form, or paste an encoded value and read the original back. Swap turns a result into the source for the next pass. The last conversion is kept when the page reloads. Nothing leaves the browser.",
  "category": "productivity",
  "tags": [],
  "icon": "docs",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/base64-tool"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/use-clipboard": "0.1.0",
      "@lacuna/use-local-record": "0.1.0"
    }
  },
  "capabilities": [
    "convert:text"
  ],
  "permissions": {
    "records": [
      {
        "kind": "base64-conversion",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Keep the last conversion so a reload restores it"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "base64-conversion"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
