{
  "manifestVersion": 1,
  "id": "lacuna.flip-image",
  "name": "Image Flipper",
  "version": "0.1.0",
  "summary": "Flip and rotate a local image in the browser.",
  "description": "Drop a PNG, preview it, apply horizontal and vertical flips and 90-degree rotations, and download the result. The image and its transformation state survive a page reload. Nothing leaves the browser.",
  "category": "productivity",
  "tags": [],
  "icon": "paint",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/flip-image"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "convert:image->image",
    "export:image"
  ],
  "permissions": {
    "records": [
      {
        "kind": "image",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the loaded image and its flip and rotation state"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "image"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
