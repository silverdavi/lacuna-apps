{
  "manifestVersion": 1,
  "id": "lacuna.flip-image",
  "name": "Image Flipper",
  "version": "0.1.0",
  "summary": "Flip and rotate an image, then download it.",
  "description": "Drop an image to begin. Mirror it horizontally or vertically, rotate it in 90° steps, and download the result. The image and its transformations are kept on this device, so you still have them after a reload. Nothing leaves the browser.",
  "category": "productivity",
  "tags": ["image", "flip", "rotate", "mirror"],
  "icon": "paint",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "bundle",
    "route": "/app/flip-image",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/before-after": "0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/image-ops": "0.1.0",
      "@lacuna/use-local-record": "0.1.0"
    }
  },
  "capabilities": [
    "view:image",
    "edit:image"
  ],
  "permissions": {
    "records": [
      {
        "kind": "flip-image-session",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Keep the loaded image and its transformations on this device"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "flip-image-session"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
