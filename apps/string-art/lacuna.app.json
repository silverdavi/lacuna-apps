{
  "manifestVersion": 1,
  "id": "lacuna.string-art",
  "name": "String Art Generator",
  "version": "0.1.0",
  "summary": "Generate string art patterns from points, step, and color, then export a PNG.",
  "description": "Set the number of points, the step, and a color, then generate a string art pattern on a canvas. Export the pattern as a PNG or clear it. Generated patterns are kept on this device and listed in a local history. Nothing leaves the browser.",
  "category": "productivity",
  "tags": ["art", "canvas", "export"],
  "icon": "design",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "bundle",
    "route": "/app/string-art",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/image-ops": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0",
      "@lacuna/use-local-record": "0.1.0"
    }
  },
  "capabilities": [
    "edit:string-art"
  ],
  "permissions": {
    "records": [
      {
        "kind": "string-art",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the current pattern and its history so they survive a reload"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "string-art"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
