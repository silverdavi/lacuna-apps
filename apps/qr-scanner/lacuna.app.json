{
  "manifestVersion": 1,
  "id": "lacuna.qr-scanner",
  "name": "QR Code Scanner",
  "version": "0.1.0",
  "summary": "Read codes from an image and create QR or barcode images from text.",
  "description": "Upload a picture of a code to read its contents, or type text to draw a QR Code, EAN-13, or Code 128 and save it as a PNG. Every scan and encode is a record kept in this space. Nothing leaves the browser.",
  "category": "productivity",
  "icon": "search",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "builtin",
    "route": "/app/qr-scanner"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "create:qr",
    "import:image->text",
    "export:text->image"
  ],
  "permissions": {
    "records": [
      {
        "kind": "qr-scan",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the codes read from images and the codes generated from text"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "qr-scan"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
