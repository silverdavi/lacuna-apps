{
  "manifestVersion": 1,
  "id": "lacuna.game-of-life",
  "name": "Game of Life",
  "version": "0.1.0",
  "summary": "Step Conway's Game of Life on a grid: toggle cells, run the world, watch patterns emerge.",
  "description": "Conway's original cellular automaton on a 10-row by 9-column board. Click a cell to toggle it, then step or run the world at a steady pace. Stable patterns such as the block hold, while gliders and other traffic fade or move. The board state stays on this device and survives a reload.",
  "category": "productivity",
  "icon": "grid",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "builtin",
    "route": "/app/game-of-life",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/ui": "^0.1.0",
      "@lacuna/host-mock": "0.1.0"
    }
  },
  "capabilities": [
    "create:grid",
    "edit:grid"
  ],
  "permissions": {
    "records": [
      {
        "kind": "grid",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the board and run state so the world survives a reload"
      }
    ],
    "platform": [
      "identity.profile.read"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "game"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
