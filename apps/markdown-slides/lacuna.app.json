{
  "manifestVersion": 1,
  "id": "lacuna.markdown-slides",
  "name": "Markdown Slide Deck",
  "version": "0.1.0",
  "summary": "Write a slide deck in markdown, split slides on ---, and preview them live.",
  "description": "Edit a slide deck as markdown. Slides are separated by --- lines. The preview renders headings, lists, task lists with clickable checkboxes, and tables. Undo reverts the last edit. Export prints the deck or downloads it as deck.json. The deck is kept on this device. Nothing leaves the browser.",
  "category": "productivity",
  "icon": "docs",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "builtin",
    "route": "/app/markdown-slides"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/use-undo-stack": "0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/use-local-record": "0.1.0",
      "@lacuna/markdown-to-html": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0",
      "@lacuna/text-transforms": "0.1.0"
    }
  },
  "capabilities": [
    "edit:deck",
    "view:deck",
    "export:deck"
  ],
  "permissions": {
    "records": [
      {
        "kind": "slide-deck",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the last deck text"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "slide-deck"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
