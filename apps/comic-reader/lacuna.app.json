{
  "manifestVersion": 1,
  "id": "lacuna.comic-reader",
  "name": "Comic Book Reader",
  "version": "0.1.0",
  "summary": "Open a CBZ or CRB, read it page by page, and keep bookmarks.",
  "description": "A paged reader for CBZ and CRB comic files. Open a file, turn pages, mark pages, export a page as PNG. The reader position and bookmarks are the records. Nothing leaves the browser.",
  "category": "personal",
  "icon": "files",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "builtin",
    "route": "/app/comic-reader"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/ui": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/use-local-record": "0.1.0"
    }
  },
  "capabilities": [
    "view:cbz",
    "view:crb",
    "export:png"
  ],
  "permissions": {
    "records": [
      {
        "kind": "comic-reader",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the open file, the current page, and the bookmarked pages"
      }
    ],
    "platform": [
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "comic-reader"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ]
  }
}
