{
  "manifestVersion": 1,
  "id": "lacuna.pdf-splitter",
  "name": "PDF Splitter",
  "version": "0.1.0",
  "summary": "Split, merge, and reorder PDF pages locally.",
  "description": "A local PDF splitter. Drop files, split page ranges, merge files, and reorder pages. Everything runs in the browser and history is kept on this device.",
  "category": "productivity",
  "tags": ["pdf", "split", "merge", "reorder"],
  "icon": "pdf",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "bundle",
    "route": "/app/pdf-splitter",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/pdf-ops": "0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/host-mock": "0.1.0"
    }
  },
  "capabilities": [
    "edit:pdf-splitter"
  ],
  "permissions": {
    "records": [
      {
        "kind": "pdf-operation",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Own PDF Splitter operation history"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "pdf-operation"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
