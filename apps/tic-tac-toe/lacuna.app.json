{
  "manifestVersion": 1,
  "id": "lacuna.tic-tac-toe",
  "name": "Tic Tac Toe",
  "version": "0.1.0",
  "summary": "Play rounds of tic tac toe on a 3x3 grid.",
  "description": "Two players take turns placing marks on a 3x3 grid. The app keeps the current turn, declares the winner or a draw, and keeps a running score. The board and the score survive a reload. Nothing leaves the browser.",
  "category": "personal",
  "icon": "grid",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/tic-tac-toe"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/export-menu": "0.1.0",
      "@lacuna/grid-utils": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/use-clipboard": "0.1.0",
      "@lacuna/use-hotkeys": "0.1.0"
    }
  },
  "capabilities": [
    "create:game",
    "view:score",
    "export:game"
  ],
  "permissions": {
    "records": [
      {
        "kind": "game",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the board, the current turn, and the running score"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "game"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
