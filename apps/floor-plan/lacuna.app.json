{
  "manifestVersion": 1,
  "id": "lacuna.floor-plan",
  "name": "Floor Plan Editor",
  "version": "0.1.0",
  "summary": "Sketch floor plans with layers and rooms, preview them on a canvas, and export the result as a PNG.",
  "description": "Add layers and rooms, name the rooms, pick a canvas background, and export a PNG. Everything is kept on this device; nothing leaves the browser.",
  "category": "productivity",
  "tags": [],
  "icon": "design",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/floor-plan"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "create:layer",
    "create:room",
    "export:png"
  ],
  "permissions": {
    "records": [
      {
        "kind": "floor-plan",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Keep the layers and rooms of the current floor plan"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "floor-plan"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
