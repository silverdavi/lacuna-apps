{
  "manifestVersion": 1,
  "id": "lacuna.ebook-converter",
  "name": "EPUB Converter",
  "version": "0.1.0",
  "summary": "Assemble Markdown chapters into valid EPUB 3 e-books or export to HTML and TXT.",
  "description": "Write or open Markdown chapters split by level-1 headings, set book title, author, and language metadata, inspect detected chapters, and build a valid EPUB 3 (.epub) package or standalone HTML reader offline.",
  "category": "productivity",
  "tags": ["converter", "conversion-suite", "epub", "ebook", "markdown", "publishing"],
  "icon": "wiki",
  "relationship": { "kind": "standalone" },
  "maintainer": { "type": "first-party", "name": "Lacuna", "url": "https://lacunaos.com" },
  "source": { "repository": "https://github.com/silverdavi/lacuna-apps", "license": "MIT" },
  "pricing": { "model": "free", "inAppPurchases": false, "ads": false },
  "maturity": "demo-working",
  "entry": { "type": "bundle", "route": "/app/ebook-converter", "bundle": "dist/index.html" },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/markdown-to-html": "0.1.0",
      "@lacuna/use-local-record": "0.1.0"
    }
  },
  "capabilities": ["convert:markdown->ebook", "edit:ebook-converter"],
  "permissions": {
    "records": [
      {
        "kind": "ebook-converter",
        "access": ["read", "write", "create"],
        "purpose": "Persist active manuscript chapters and EPUB metadata across reloads"
      }
    ],
    "platform": ["files.pick", "files.save"],
    "network": { "origins": [] },
    "dataClasses": [],
    "availability": { "spaceTypes": ["any"] }
  },
  "sharing": { "owns": ["ebook-converter"], "reads": [], "handoffs": [] },
  "quality": {
    "tests": ["tests/acceptance.spec.ts"],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
