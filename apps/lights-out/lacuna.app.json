{
  "manifestVersion": 1,
  "id": "lacuna.lights-out",
  "name": "Lights Out",
  "version": "0.1.0",
  "summary": "Solve the 5x5 Lights Out puzzle.",
  "description": "Click cells to toggle them and their orthogonal neighbors. Turn off every light. A deterministic seed generates each board, the move count is tracked, and the best score is saved locally.",
  "category": "personal",
  "tags": [],
  "icon": "grid",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "bundle",
    "route": "/app/lights-out",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/board-grid": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/grid-utils": "0.1.0",
      "@lacuna/random": "0.1.0",
      "@lacuna/use-local-record": "0.1.0"
    }
  },
  "capabilities": [
    "create:game"
  ],
  "permissions": {
    "records": [
      {
        "kind": "game-state",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Save the board, move count, and best score"
      }
    ],
    "platform": [
      "identity.profile.read"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "game-state"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
