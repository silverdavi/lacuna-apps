{
  "manifestVersion": 1,
  "id": "lacuna.unit-convert",
  "name": "Unit convert",
  "version": "0.1.0",
  "summary": "Convert length, mass, volume, temperature, and area.",
  "description": "Pick a category, type a value in either field, and see the other update. Temperature, length, mass, volume, and area. Recent conversions stay on this page.",
  "category": "productivity",
  "icon": "grid",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "builtin",
    "route": "/app/unit-convert"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "create:conversion"
  ],
  "permissions": {
    "records": [
      {
        "kind": "conversion",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Keep the recent conversion list"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "conversion"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/length-convert.spec.ts",
      "tests/two-way.spec.ts",
      "tests/temperature.spec.ts",
      "tests/category-switch.spec.ts",
      "tests/swap.spec.ts",
      "tests/non-numeric.spec.ts",
      "tests/recent-list.spec.ts",
      "tests/recent-reload.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
