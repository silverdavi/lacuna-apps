{
  "manifestVersion": 1,
  "id": "lacuna.barcode-generator",
  "name": "Barcode Generator",
  "version": "0.1.0",
  "summary": "Create Code 128, EAN-13, and QR barcodes from text and download them as PNG.",
  "description": "Choose a barcode type, enter data, and download the generated image. Code 128, EAN-13, and QR codes. The last generation is kept on the page and in the app store. Nothing leaves the browser.",
  "category": "productivity",
  "icon": "files",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/barcode-generator"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/use-clipboard": "0.1.0",
      "@lacuna/use-local-record": "0.1.0"
    }
  },
  "capabilities": [
    "create:barcode",
    "export:barcode",
    "render:barcode"
  ],
  "permissions": {
    "records": [
      {
        "kind": "barcode",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the barcode type, data, and image of the last generation"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "barcode"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/00-setup.spec.ts",
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
