{
  "manifestVersion": 1,
  "id": "lacuna.doc-converter",
  "name": "Document Converter",
  "version": "0.1.0",
  "summary": "Convert documents between Markdown, HTML, Plain Text, RTF, DOCX, and PDF offline.",
  "description": "Write, paste, or open Markdown, HTML, RTF, or plain text documents, preview sanitized HTML live, check word and reading-time counts, and export clean HTML, Markdown, RTF, valid OOXML DOCX, or PDF files offline.",
  "category": "productivity",
  "tags": ["converter", "conversion-suite", "markdown", "html", "docx", "rtf", "pdf"],
  "icon": "docs",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "bundle",
    "route": "/app/doc-converter",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/markdown-to-html": "0.1.0",
      "@lacuna/text-stats": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0",
      "@lacuna/use-local-record": "0.1.0"
    }
  },
  "capabilities": [
    "convert:markdown->html",
    "convert:html->markdown",
    "edit:doc-converter"
  ],
  "permissions": {
    "records": [
      {
        "kind": "doc-converter",
        "access": ["read", "write", "create"],
        "purpose": "Persist active document text, title, and source/target format across reloads"
      }
    ],
    "platform": ["files.pick", "files.save", "clipboard.write"],
    "network": { "origins": [] },
    "dataClasses": [],
    "availability": { "spaceTypes": ["any"] }
  },
  "sharing": {
    "owns": ["doc-converter"],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": ["tests/acceptance.spec.ts"],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
