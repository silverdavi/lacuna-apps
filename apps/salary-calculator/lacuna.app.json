{
  "manifestVersion": 1,
  "id": "lacuna.salary-calculator",
  "name": "Salary Calculator",
  "version": "0.1.0",
  "summary": "See the net pay of a gross annual salary after standard deductions.",
  "description": "Enter a gross annual salary and standard deductions. The app shows the net pay, a breakdown of each deduction, and a chart of the pay composition. The last calculation is kept on the page. Nothing leaves the browser.",
  "category": "productivity",
  "icon": "payroll",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/salary-calculator"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/chart": "0.1.0",
      "@lacuna/money": "0.1.0",
      "@lacuna/use-local-record": "0.1.0"
    }
  },
  "capabilities": [
    "view:salary",
    "view:breakdown"
  ],
  "permissions": {
    "records": [
      {
        "kind": "salary-calculation",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the last gross salary, deductions, and calculated result"
      }
    ],
    "platform": [
      "identity.profile.read",
      "clipboard.write"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "salary-calculation"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
