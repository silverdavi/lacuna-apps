{
  "manifestVersion": 1,
  "id": "lacuna.coin-flip",
  "name": "Coin Flip",
  "version": "0.1.0",
  "summary": "Flip a coin, watch the streak, keep the best.",
  "description": "Flip a virtual coin to make a quick decision. The card shows the result, the streak counts matching flips, and the best streak is remembered. Nothing leaves the browser.",
  "category": "personal",
  "tags": ["random", "decisions", "streaks"],
  "icon": "grid",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/coin-flip"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/host-mock": "0.1.0"
    }
  },
  "capabilities": [
    "create:flip"
  ],
  "permissions": {
    "records": [
      {
        "kind": "flip",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the latest flip, the current streak, and the best streak"
      }
    ],
    "platform": [],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "flip"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
