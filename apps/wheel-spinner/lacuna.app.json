{
  "manifestVersion": 1,
  "id": "lacuna.wheel-spinner",
  "name": "Wheel Spinner",
  "version": "0.1.0",
  "summary": "Add entries to a wheel, spin to pick a winner, and keep a log of results.",
  "description": "A list of entries you add, a spin that picks one at random, a result banner you can copy, and a history of every spin. Everything persists in the browser.",
  "category": "productivity",
  "icon": "timesheets",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "builtin",
    "route": "/app/wheel-spinner"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/random": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "create:wheel-entry",
    "edit:wheel-entry",
    "view:spin-log"
  ],
  "permissions": {
    "records": [
      {
        "kind": "wheel-entry",
        "access": [
          "read",
          "write",
          "create",
          "delete"
        ],
        "purpose": "Store the wheel's entries and the log of spins"
      }
    ],
    "platform": [
      "identity.profile.read"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "wheel-entry"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
