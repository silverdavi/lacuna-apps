{
  "manifestVersion": 1,
  "id": "lacuna.voice-recorder",
  "name": "Voice Recorder",
  "version": "0.1.0",
  "summary": "Record voice clips, keep them on this device, and save them as WAV or MP3.",
  "description": "A small voice recorder. Press Record, the clip plays back with its duration, and every clip is kept in a list on this device. Download a clip as WAV or MP3, delete the ones you do not want, and the list survives a reload.",
  "category": "productivity",
  "icon": "notes",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "bundle",
    "route": "/app/voice-recorder",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/ui": "^0.1.0",
      "@lacuna/use-media-recorder": "0.1.0",
      "@lacuna/format-duration": "0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/host-mock": "0.1.0"
    }
  },
  "capabilities": [
    "create:clip"
  ],
  "permissions": {
    "records": [
      {
        "kind": "clip",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the recorded voice clips and the recording settings"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "clip"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
