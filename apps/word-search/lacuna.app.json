{
  "manifestVersion": 1,
  "id": "lacuna.word-search",
  "name": "Word Search",
  "version": "0.1.0",
  "summary": "Generate and solve letter grid puzzles.",
  "description": "Type a comma-separated list of words, pick a grid size, and Generate a puzzle. Find the words by selecting their first and last letters. The board, found words, score, and best score are kept when the page reloads.",
  "category": "personal",
  "tags": [],
  "icon": "search",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/word-search"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/random": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/use-clipboard": "0.1.0"
    }
  },
  "capabilities": [
    "create:puzzle",
    "fill:puzzle"
  ],
  "permissions": {
    "records": [
      {
        "kind": "puzzle",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the current puzzle grid, found words, score, and best score"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "puzzle"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
