{
  "manifestVersion": 1,
  "id": "lacuna.pdf-converter",
  "name": "PDF Converter",
  "version": "0.1.0",
  "summary": "Build multi-page PDFs from text or extract text and metadata from PDFs offline.",
  "description": "Create clean multi-page PDF documents from plain text or Markdown with Letter or A4 layouts, page numbers, and optional watermarks, or drop a PDF to inspect structure and extract text to TXT, Markdown, or JSON.",
  "category": "productivity",
  "tags": ["converter", "conversion-suite", "pdf", "document", "extract", "watermark"],
  "icon": "pdf",
  "relationship": { "kind": "standalone" },
  "maintainer": { "type": "first-party", "name": "Lacuna", "url": "https://lacunaos.com" },
  "source": { "repository": "https://github.com/silverdavi/lacuna-apps", "license": "MIT" },
  "pricing": { "model": "free", "inAppPurchases": false, "ads": false },
  "maturity": "demo-working",
  "entry": { "type": "bundle", "route": "/app/pdf-converter", "bundle": "dist/index.html" },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0",
      "@lacuna/use-local-record": "0.1.0"
    }
  },
  "capabilities": ["convert:text->document", "edit:pdf-converter"],
  "permissions": {
    "records": [
      {
        "kind": "pdf-converter",
        "access": ["read", "write", "create"],
        "purpose": "Persist active PDF builder draft and page layout settings across reloads"
      }
    ],
    "platform": ["files.pick", "files.save", "clipboard.write"],
    "network": { "origins": [] },
    "dataClasses": [],
    "availability": { "spaceTypes": ["any"] }
  },
  "sharing": { "owns": ["pdf-converter"], "reads": [], "handoffs": [] },
  "quality": {
    "tests": ["tests/acceptance.spec.ts"],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
