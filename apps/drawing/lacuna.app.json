{
  "manifestVersion": 1,
  "id": "lacuna.drawing",
  "name": "Sketch Pad",
  "version": "0.1.0",
  "summary": "Sketch on an infinite canvas with layers, a brush, and a color picker, then export the result as a PNG.",
  "description": "Add layers, pick a brush color and size, draw on the canvas, and export a PNG. Everything is kept on this device; nothing leaves the browser.",
  "category": "productivity",
  "tags": [],
  "icon": "design",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/drawing"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/range-slider": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "create:layer",
    "fill:stroke",
    "export:png"
  ],
  "permissions": {
    "records": [
      {
        "kind": "drawing",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Keep the layers and strokes of the current sketch"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "drawing"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
