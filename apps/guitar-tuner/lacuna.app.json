{
  "manifestVersion": 1,
  "id": "lacuna.guitar-tuner",
  "name": "Guitar Tuner",
  "version": "0.1.0",
  "summary": "Tune your guitar with a reference tone and a live frequency detector.",
  "description": "Pick a string, play a reference tone, record a sample, and see the detected frequency and cent offset. Save readings to a local tuning log. Runs entirely in the browser; nothing leaves the device.",
  "category": "productivity",
  "icon": "analytics",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "builtin",
    "route": "/app/guitar-tuner"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "create:tuning-session",
    "create:media-recorder",
    "view:tuning-log"
  ],
  "permissions": {
    "records": [
      {
        "kind": "tuning-entry",
        "access": [
          "read",
          "write",
          "create",
          "delete"
        ],
        "purpose": "Store tuning log entries: string, target frequency, detected frequency, cent offset, and date"
      }
    ],
    "platform": [
      "identity.profile.read"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "tuning-entry"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
