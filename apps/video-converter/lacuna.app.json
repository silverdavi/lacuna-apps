{
  "manifestVersion": 1,
  "id": "lacuna.video-converter",
  "name": "Video Converter",
  "version": "0.1.0",
  "summary": "Transcode video to WebM, scale resolution, mute audio, and grab poster frames offline.",
  "description": "Open a local MP4, WebM, or MOV video or generate a test clip, inspect dimensions and duration, transcode locally to WebM with target resolution and bitrate controls, mute audio, or capture crisp PNG poster frames.",
  "category": "productivity",
  "tags": ["converter", "conversion-suite", "video", "webm", "mp4", "transcode"],
  "icon": "meeting",
  "relationship": { "kind": "standalone" },
  "maintainer": { "type": "first-party", "name": "Lacuna", "url": "https://lacunaos.com" },
  "source": { "repository": "https://github.com/silverdavi/lacuna-apps", "license": "MIT" },
  "pricing": { "model": "free", "inAppPurchases": false, "ads": false },
  "maturity": "demo-working",
  "entry": { "type": "bundle", "route": "/app/video-converter", "bundle": "dist/index.html" },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/use-local-record": "0.1.0"
    }
  },
  "capabilities": ["convert:video->clip", "edit:video-converter"],
  "permissions": {
    "records": [
      {
        "kind": "video-converter",
        "access": ["read", "write", "create"],
        "purpose": "Persist video export presets and recent conversion history across reloads"
      }
    ],
    "platform": ["files.pick", "files.save"],
    "network": { "origins": [] },
    "dataClasses": [],
    "availability": { "spaceTypes": ["any"] }
  },
  "sharing": { "owns": ["video-converter"], "reads": [], "handoffs": [] },
  "quality": {
    "tests": ["tests/acceptance.spec.ts"],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
