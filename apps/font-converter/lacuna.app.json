{
  "manifestVersion": 1,
  "id": "lacuna.font-converter",
  "name": "Font Converter",
  "version": "0.1.0",
  "summary": "Inspect TTF, OTF, WOFF, and WOFF2 font headers and generate @font-face CSS offline.",
  "description": "Drop any TTF, OTF, WOFF, or WOFF2 web font or test with a sample SFNT header to inspect magic signatures and OpenType tables, generate @font-face CSS or inline Base64 font stylesheets, and export CSS offline.",
  "category": "productivity",
  "tags": ["converter", "conversion-suite", "font", "woff2", "ttf", "otf", "css"],
  "icon": "design",
  "relationship": { "kind": "standalone" },
  "maintainer": { "type": "first-party", "name": "Lacuna", "url": "https://lacunaos.com" },
  "source": { "repository": "https://github.com/silverdavi/lacuna-apps", "license": "MIT" },
  "pricing": { "model": "free", "inAppPurchases": false, "ads": false },
  "maturity": "demo-working",
  "entry": { "type": "bundle", "route": "/app/font-converter", "bundle": "dist/index.html" },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0",
      "@lacuna/use-local-record": "0.1.0"
    }
  },
  "capabilities": ["convert:font->css", "edit:font-converter"],
  "permissions": {
    "records": [
      {
        "kind": "font-converter",
        "access": ["read", "write", "create"],
        "purpose": "Persist font family name, weight, and @font-face options across reloads"
      }
    ],
    "platform": ["files.pick", "files.save", "clipboard.write"],
    "network": { "origins": [] },
    "dataClasses": [],
    "availability": { "spaceTypes": ["any"] }
  },
  "sharing": { "owns": ["font-converter"], "reads": [], "handoffs": [] },
  "quality": {
    "tests": ["tests/acceptance.spec.ts"],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
