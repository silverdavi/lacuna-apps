{
  "manifestVersion": 1,
  "id": "lacuna.audio-trimmer",
  "name": "Audio Cutter",
  "version": "0.1.0",
  "summary": "Trim audio clips on a waveform with fade-in, fade-out, speed shift, and WAV export.",
  "description": "Inspect an audio waveform locally, set exact start and end trim bounds, apply smooth fade-in and fade-out ramps or playback speed shifts, preview the cut, and export a clean WAV file offline.",
  "category": "productivity",
  "tags": ["converter", "conversion-suite", "audio", "trim", "waveform", "wav"],
  "icon": "meeting",
  "relationship": { "kind": "standalone" },
  "maintainer": { "type": "first-party", "name": "Lacuna", "url": "https://lacunaos.com" },
  "source": { "repository": "https://github.com/silverdavi/lacuna-apps", "license": "MIT" },
  "pricing": { "model": "free", "inAppPurchases": false, "ads": false },
  "maturity": "demo-working",
  "entry": { "type": "bundle", "route": "/app/audio-trimmer", "bundle": "dist/index.html" },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/use-local-record": "0.1.0"
    }
  },
  "capabilities": ["edit:audio-trimmer", "convert:audio->clip"],
  "permissions": {
    "records": [
      {
        "kind": "audio-trimmer",
        "access": ["read", "write", "create"],
        "purpose": "Persist trim, fade, and speed preferences across reloads"
      }
    ],
    "platform": ["files.pick", "files.save"],
    "network": { "origins": [] },
    "dataClasses": [],
    "availability": { "spaceTypes": ["any"] }
  },
  "sharing": { "owns": ["audio-trimmer"], "reads": [], "handoffs": [] },
  "quality": {
    "tests": ["tests/acceptance.spec.ts"],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
