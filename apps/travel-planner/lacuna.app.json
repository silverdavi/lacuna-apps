{
  "manifestVersion": 1,
  "id": "lacuna.travel-planner",
  "name": "Travel Planner",
  "version": "0.1.0",
  "summary": "Plan a trip: calendar of events, a budget, and a packing list.",
  "description": "Track trip events on a monthly calendar, keep a running budget, and check off a packing list. Export the calendar to ICS. Everything is stored locally and survives reload. Nothing leaves the browser.",
  "category": "productivity",
  "icon": "calendar",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/travel-planner"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/use-local-record": "0.1.0",
      "@lacuna/date-math": "0.1.0",
      "@lacuna/ics-calendar": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0"
    }
  },
  "capabilities": [
    "create:trip"
  ],
  "sharing": {
    "owns": ["trip"],
    "reads": [],
    "handoffs": []
  },
  "permissions": {
    "records": [
      {
        "kind": "trip",
        "access": ["read", "write", "create"],
        "purpose": "Store trip events, budget items, and packing list items"
      }
    ],
    "platform": [],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": ["personal"]
    }
  },
  "quality": {
    "tests": ["tests/acceptance.spec.ts"]
  }
}
