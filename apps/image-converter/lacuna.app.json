{
  "manifestVersion": 1,
  "id": "lacuna.image-converter",
  "name": "Image Converter",
  "version": "0.1.0",
  "summary": "Batch convert images across PNG, JPEG, WebP, BMP, ICO, QOI, and SVG offline.",
  "description": "Drop one or more raster or vector images, pick an output format, adjust quality, scale, rotation, or grayscale, inspect exact byte savings, and download individual files or a single ZIP archive offline.",
  "category": "productivity",
  "tags": ["converter", "conversion-suite", "image", "png", "jpeg", "webp", "qoi", "ico"],
  "icon": "paint",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "bundle",
    "route": "/app/image-converter",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0",
      "@lacuna/use-local-record": "0.1.0"
    }
  },
  "capabilities": [
    "convert:image->image",
    "edit:image-converter"
  ],
  "permissions": {
    "records": [
      {
        "kind": "image-converter",
        "access": ["read", "write", "create"],
        "purpose": "Store recent image conversion settings and history across reloads"
      }
    ],
    "platform": ["files.pick", "files.save"],
    "network": { "origins": [] },
    "dataClasses": [],
    "availability": { "spaceTypes": ["any"] }
  },
  "sharing": {
    "owns": ["image-converter"],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": ["tests/acceptance.spec.ts"],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
