{
  "manifestVersion": 1,
  "id": "lacuna.text-diff",
  "name": "Text Diff Checker",
  "version": "0.1.0",
  "summary": "Compare two pieces of text line by line and see what changed.",
  "description": "Paste two texts, compare them line by line, and see which lines were added or removed. Copy the diff to the clipboard or download it as diff.txt. The last comparison survives reload. Nothing leaves the browser.",
  "category": "productivity",
  "icon": "docs",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/text-diff"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/use-local-record": "0.1.0"
    }
  },
  "capabilities": [
    "edit:text-diff"
  ],
  "permissions": {
    "records": [
      {
        "kind": "text-diff",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the last text comparison between visits"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "text-diff"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
