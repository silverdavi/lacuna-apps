{
  "manifestVersion": 1,
  "id": "lacuna.calendar-app",
  "name": "Personal Calendar",
  "version": "0.1.0",
  "summary": "A personal month calendar: add events, browse the month grid, and exchange iCalendar (.ics) files.",
  "description": "Keep a personal calendar on this device. Add titled events with a date and time, move through months, open an event's details, remove it, export your schedule as an iCalendar file, or import events from a .ics file.",
  "category": "productivity",
  "tags": [],
  "icon": "calendar",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/calendar-app"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/date-math": "0.1.0",
      "@lacuna/ics-calendar": "0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/host-mock": "0.1.0"
    }
  },
  "capabilities": [
    "edit:calendar-app"
  ],
  "permissions": {
    "records": [
      {
        "kind": "calendar-event",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store personal calendar events"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "calendar-event"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
