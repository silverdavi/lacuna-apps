{
  "manifestVersion": 1,
  "id": "lacuna.warranty-tracker",
  "name": "Warranty Tracker",
  "version": "0.1.0",
  "summary": "Track products, purchase dates, and warranty expirations.",
  "description": "Add purchased products with their purchase date and warranty end, see which are active, expiring soon, or expired, filter and sort the list, and export it as CSV. Records persist locally in the browser.",
  "category": "productivity",
  "tags": ["warranty", "products", "dates"],
  "icon": "calendar",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/warranty-tracker"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/ui": "^0.1.0",
      "@lacuna/date-math": "0.1.0",
      "@lacuna/csv-parse": "0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/host-mock": "0.1.0"
    }
  },
  "capabilities": [
    "create:warranty",
    "edit:warranty",
    "view:warranty",
    "export:warranty"
  ],
  "permissions": {
    "records": [
      {
        "kind": "warranty",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store warranty records for purchased products"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "warranty"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
