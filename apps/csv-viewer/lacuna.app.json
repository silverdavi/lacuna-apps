{
  "manifestVersion": 1,
  "id": "lacuna.csv-viewer",
  "name": "CSV Viewer",
  "version": "0.1.0",
  "summary": "Open a CSV file, browse it in a grid, filter, and export it.",
  "description": "Pick a CSV file and it renders as a grid with a header row. Filter the rows by text, export the current view to CSV, and clear the filter. Keyboard navigation moves the active cell. The last file you open and its filter survive a reload. Nothing leaves the browser.",
  "category": "productivity",
  "tags": ["csv", "data", "spreadsheet", "import", "export"],
  "icon": "sheets",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "bundle",
    "route": "/app/csv-viewer",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/csv-parse": "0.1.0",
      "@lacuna/file-save-open": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/use-local-record": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "create:view"
  ],
  "permissions": {
    "records": [
      {
        "kind": "csv-view",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the last opened CSV file and the active filter so the view survives a reload"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "csv-view"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
