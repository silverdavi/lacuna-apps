{
  "manifestVersion": 1,
  "id": "lacuna.grade-calculator",
  "name": "Grade Calculator",
  "version": "0.1.0",
  "summary": "Add graded components and weight them to a final grade.",
  "description": "Add assessment components with a name, a score, and a weight percentage. See the final weighted grade and a breakdown of each component's contribution. The list survives a reload. Nothing leaves the browser.",
  "category": "productivity",
  "icon": "school",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "bundle",
    "route": "/app/grade-calculator",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "create:component",
    "edit:component"
  ],
  "permissions": {
    "records": [
      {
        "kind": "component",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the assessment components and their weighted contributions"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "component"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
