{
  "manifestVersion": 1,
  "id": "lacuna.color-picker",
  "name": "Color Picker",
  "version": "0.1.0",
  "summary": "Pick a color and convert it between hex, RGB, and HSL.",
  "description": "Select a color and convert its value between hex, RGB, and HSL. Generate palettes, check WCAG contrast ratios, and copy values to the clipboard. The current color and palette survive page reloads.",
  "category": "productivity",
  "tags": ["color", "converter", "palette"],
  "icon": "paint",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "builtin",
    "route": "/app/color-picker"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "convert:color",
    "create:palette",
    "export:color"
  ],
  "permissions": {
    "records": [
      {
        "kind": "color",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the current color and palette so they survive a reload"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "color"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
