{
  "manifestVersion": 1,
  "id": "lacuna.gpa-calculator",
  "name": "GPA Calculator",
  "version": "0.1.0",
  "summary": "A weighted GPA calculator.",
  "description": "Add courses with credits and letter grades, choose a 4.0 or 5.0 scale, and see the running GPA, the grade point per course, and a chart of the points.",
  "category": "productivity",
  "tags": [],
  "icon": "school",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "bundle",
    "route": "/app/gpa-calculator",
    "bundle": "dist/index.html"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/calculator-kit": "0.2.0",
      "@lacuna/chart": "0.1.0",
      "@lacuna/export-menu": "0.1.0",
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/ui": "0.1.0",
      "@lacuna/use-clipboard": "0.1.0"
    }
  },
  "capabilities": [
    "edit:gpa-calculator"
  ],
  "permissions": {
    "records": [
      {
        "kind": "gpa-calculator",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Own GPA Calculator records"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "any"
      ]
    }
  },
  "sharing": {
    "owns": [
      "gpa-calculator"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  }
}
