{
  "manifestVersion": 1,
  "id": "lacuna.weight-tracker",
  "name": "Weight Tracker",
  "version": "0.1.0",
  "summary": "Log body weight on a date and watch the trend line.",
  "description": "A list of weight entries with dates and values, a line chart of progress, and a summary of the latest reading and the change from the first entry. Everything persists in the browser.",
  "category": "personal",
  "icon": "analytics",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "builtin",
    "route": "/app/weight-tracker"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "create:weight-entry",
    "view:chart"
  ],
  "permissions": {
    "records": [
      {
        "kind": "weight-entry",
        "access": [
          "read",
          "write",
          "create",
          "delete"
        ],
        "purpose": "Store dated body weight entries and the trend they form"
      }
    ],
    "platform": [
      "identity.profile.read"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "weight-entry"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
