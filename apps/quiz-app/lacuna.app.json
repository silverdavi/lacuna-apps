{
  "manifestVersion": 1,
  "id": "lacuna.quiz-app",
  "name": "Quiz App",
  "version": "0.1.0",
  "summary": "Build a personal question bank and run timed study sessions.",
  "description": "A personal question bank and timed study sessions. Create multiple-choice, text, and number questions, answer them in shuffled order, and review mistakes. The bank and session history stay in the browser.",
  "category": "productivity",
  "icon": "school",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-working",
  "entry": {
    "type": "builtin",
    "route": "/app/quiz-app"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/host-mock": "0.1.0",
      "@lacuna/random": "0.1.0",
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0"
    }
  },
  "capabilities": [
    "create:question",
    "view:session"
  ],
  "permissions": {
    "records": [
      {
        "kind": "question",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the question bank and study session history"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "question"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
