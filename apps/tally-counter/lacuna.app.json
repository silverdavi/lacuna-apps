{
  "manifestVersion": 1,
  "id": "lacuna.tally-counter",
  "name": "Tally Counter",
  "version": "0.1.0",
  "summary": "Tally events through the day against a daily goal, and watch your rhythm in the history.",
  "description": "A daily event counter. Add to the counter, set a daily goal, and follow the day on the progress bar. The history tab keeps the day's tally, a year heatmap, and the recent-day trend. Reset the counter when the day is done. Nothing leaves this page.",
  "category": "productivity",
  "tags": ["counter", "goals", "habits"],
  "icon": "timesheets",
  "relationship": {
    "kind": "standalone"
  },
  "maintainer": {
    "type": "first-party",
    "name": "Lacuna",
    "url": "https://lacunaos.com"
  },
  "source": {
    "repository": "https://github.com/silverdavi/lacuna-apps",
    "license": "MIT"
  },
  "pricing": {
    "model": "free",
    "inAppPurchases": false,
    "ads": false
  },
  "maturity": "demo-guided",
  "entry": {
    "type": "builtin",
    "route": "/app/tally-counter"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "modules": {
      "@lacuna/tokens": "^0.1.0",
      "@lacuna/ui": "^0.1.0",
      "@lacuna/tracker-kit": "0.2.0",
      "@lacuna/use-collection": "0.1.0",
      "@lacuna/date-math": "0.1.0",
      "@lacuna/streak-calc": "0.1.0",
      "@lacuna/heatmap": "0.1.0",
      "@lacuna/chart": "0.1.0",
      "@lacuna/date-picker": "0.1.0",
      "@lacuna/export-menu": "0.1.0",
      "@lacuna/json-backup": "0.1.0",
      "@lacuna/host-mock": "0.1.0"
    }
  },
  "capabilities": [
    "edit:tally-counter"
  ],
  "permissions": {
    "records": [
      {
        "kind": "tally-counter",
        "access": [
          "read",
          "write",
          "create"
        ],
        "purpose": "Store the daily counter, daily goal, and tally history"
      }
    ],
    "platform": [
      "identity.profile.read",
      "files.pick",
      "files.save"
    ],
    "network": {
      "origins": []
    },
    "dataClasses": [],
    "availability": {
      "spaceTypes": [
        "personal"
      ]
    }
  },
  "sharing": {
    "owns": [
      "tally-counter"
    ],
    "reads": [],
    "handoffs": []
  },
  "quality": {
    "tests": [
      "tests/acceptance.spec.ts"
    ],
    "themeMatrix": true,
    "keyboardOnly": true,
    "accessibilityScan": "axe",
    "worksWithoutNetwork": true
  }
}
